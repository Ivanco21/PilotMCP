<XtraReportsLayoutSerializer SerializerVersion="20.1.8.0" Ref="1" ControlType="Ascon.Pilot.Pilot.Reports.PilotReport, Ascon.Pilot.Pilot, Version=0.0.0.0, Culture=neutral, PublicKeyToken=null" Name="PilotReport" ScriptsSource="using Ascon.Pilot.ProjectionsRepository;&#xD;&#xA;using Ascon.Pilot.ClientCore.Search;&#xD;&#xA;using System.Linq;&#xD;&#xA;using System.Collections.Generic;&#xD;&#xA;using Ascon.Pilot.Core;&#xD;&#xA;using Ascon.Pilot.DataClasses;&#xD;&#xA;using Ascon.Pilot.Client.Search;&#xD;&#xA;using Ascon.Pilot.Common.Search;&#xD;&#xA;using Ascon.Pilot.Pilot.Reports;&#xD;&#xA;using DevExpress.XtraEditors;&#xD;&#xA;using DevExpress.XtraEditors.Controls;&#xD;&#xA;using DevExpress.XtraReports.UI;&#xD;&#xA;using DevExpress.XtraReports.Parameters;&#xD;&#xA;&#xD;&#xA;private ReportContext _context = new ReportContext();&#xD;&#xA;private ObjectState _state;&#xD;&#xA;&#xD;&#xA;private void PilotReport_DataSourceDemanded(object sender, System.EventArgs e) &#xD;&#xA;{&#xD;&#xA;      _context = new ReportContext();&#xD;&#xA;&#x9;var project = (RObject)Parameters[&quot;Project&quot;].Value;&#xD;&#xA;&#x9;if(project == null)&#xD;&#xA;&#x9;&#x9;throw new ReportException(&quot;Не выбран проект&quot;);&#xD;&#xA;      project = _context.GetObject(project.Id);&#xD;&#xA;&#x9;&#xD;&#xA;&#x9;titleLabel.Text = &quot;Список замороженных элементов&quot;;&#xD;&#xA;&#x9;var elementState = (Parameter)Parameters[&quot;elementState&quot;];&#xD;&#xA;&#x9;if (elementState == null)&#xD;&#xA;&#x9;&#x9;throw new ReportException(&quot;Не выбрано состояние выводимых элементов проекта&quot;);&#xD;&#xA;&#xD;&#xA;&#x9;_state = ObjectState.Frozen;&#x9;&#x9;&#xD;&#xA;&#x9;var value = (int)elementState.Value;&#xD;&#xA;&#x9;if (value == 1)&#xD;&#xA;&#x9;{&#xD;&#xA;&#x9;&#x9;titleLabel.Text = &quot;Список не замороженных элементов&quot;;&#xD;&#xA;&#x9;&#x9;_state = ObjectState.Alive;&#x9;&#x9;&#xD;&#xA;&#x9;}&#xD;&#xA;&#xD;&#xA;&#x9;LongRunning.Start(this, () =&gt; {&#xD;&#xA;&#x9;&#x9;// ...&#xD;&#xA;&#x9;&#x9;DataSource = CollectElements(project);&#xD;&#xA;&#x9;&#x9;//DataSource = context;&#xD;&#xA;&#x9;});&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;private void PilotReport_ParametersRequestBeforeShow(object sender, DevExpress.XtraReports.Parameters.ParametersRequestEventArgs e)&#xD;&#xA;{&#xD;&#xA;&#x9;foreach (ParameterInfo info in e.ParametersInformation) &#xD;&#xA;&#x9;{&#xD;&#xA;&#x9;      if (info.Parameter.Name == &quot;elementState&quot;) &#xD;&#xA;&#x9;&#x9;{&#xD;&#xA;&#x9;&#x9;&#x9;RadioGroup radioGroup = new RadioGroup();&#xD;&#xA;&#x9;&#x9;&#x9;radioGroup.Properties.Items.Add(new RadioGroupItem(0, &quot;замороженные элементы&quot;));&#xD;&#xA;&#x9;&#x9;&#x9;radioGroup.Properties.Items.Add(new RadioGroupItem(1, &quot;не замороженные элементы&quot;));&#xD;&#xA;&#x9;&#x9;&#x9;info.Editor = radioGroup;&#xD;&#xA;&#x9;&#x9;&#x9;radioGroup.EditValue = 1;&#xD;&#xA;&#x9;      }&#xD;&#xA;    &#x9;}&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;private IEnumerable&lt;Element&gt; CollectElements(RObject parent)&#xD;&#xA;{&#xD;&#xA;&#x9;var objectsBuilder = QueryBuilder.CreateObjectQueryBuilder();&#xD;&#xA;      objectsBuilder.Must(ObjectFields.ObjectState.Be(_state));&#xD;&#xA;      var objects = _context.GetObjects(objectsBuilder, parent.Id); &#xD;&#xA;&#x9;&#xD;&#xA;&#x9;int num = 0;&#xD;&#xA;&#x9;var result = new List&lt;Element&gt;();&#xD;&#xA;&#xD;&#xA;&#x9;foreach(var obj in objects)&#xD;&#xA;&#x9;{&#xD;&#xA;&#x9;&#x9;num++;&#xD;&#xA;&#x9;&#x9;var element = new Element()&#xD;&#xA;&#x9;&#x9;{&#xD;&#xA;&#x9;&#x9;&#x9;Num = num,&#xD;&#xA;&#x9;&#x9;&#x9;Title = obj.Title,&#xD;&#xA;&#x9;&#x9;&#x9;Link = &quot;piloturi://&quot; + obj.Id&#xD;&#xA;&#x9;&#x9;};&#xD;&#xA;&#x9;&#x9;result.Add(element);&#xD;&#xA;&#x9;}&#xD;&#xA;&#x9;return result;&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;class Element&#xD;&#xA;{&#xD;&#xA;&#x9;public int Num { get; set; }&#xD;&#xA;&#x9;public string Title { get; set; }&#xD;&#xA;&#x9;public string Link { get; set; }&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;private void tableCell3_BeforePrint(object sender, System.Drawing.Printing.PrintEventArgs e) &#xD;&#xA;{&#xD;&#xA;&#x9;var cell = sender as XRTableCell;&#xD;&#xA;&#x9;if (cell == null)&#xD;&#xA;&#x9;&#x9;return;&#xD;&#xA;&#xD;&#xA;&#x9;tableCell3.NavigateUrl = tableCell2.Text;&#xD;&#xA;}" PaperKind="A4" PageWidth="827" PageHeight="1169" Version="20.1" DataSource="#Ref-0" Font="Segoe UI, 9.75pt, charSet=204">
