<?xml version="1.0" encoding="utf-8"?>
<XtraReportsLayoutSerializer SourceReportTypesNames="bim_clashDetectionJournal" SerializerVersion="20.1.8.0" Ref="1" ControlType="Ascon.Pilot.Pilot.Reports.PilotReport, Ascon.Pilot.Pilot, Version=0.0.0.0, Culture=neutral, PublicKeyToken=null" Name="PilotReport" ScriptsSource="using Ascon.Pilot.Common.Search;&#xD;&#xA;using Ascon.Pilot.ClientCore.Search;&#xD;&#xA;using Ascon.Pilot.ProjectionsRepository;&#xD;&#xA;using System.Linq;&#xD;&#xA;using System.Collections.Generic;&#xD;&#xA;using Ascon.Pilot.Core;&#xD;&#xA;using Ascon.Pilot.SDK;&#xD;&#xA;using Ascon.Pilot.Client;&#xD;&#xA;using Ascon.Pilot.DataClasses;&#xD;&#xA;using Ascon.Pilot.Client.Search;&#xD;&#xA;using Ascon.Pilot.Pilot.Reports;&#xD;&#xA;using DevExpress.XtraReports.Parameters;&#xD;&#xA;using Ascon.Pilot.BimViewer.Data.BimModelSource;&#xD;&#xA;using Ascon.Pilot.BimViewer.Reports;&#xD;&#xA;using Ascon.Pilot.PluginLoader.CrossDomainObjects;&#xD;&#xA;using Ascon.Pilot.ClientCore;&#xD;&#xA;using Ascon.Pilot.BimUtils;&#xD;&#xA;using Ascon.Pilot.Theme.ColorScheme;&#xD;&#xA;using Ascon.Pilot.PluginLoader.ClientHost;&#xD;&#xA;&#xD;&#xA;private ReportContext Context = new ReportContext();&#xD;&#xA;private HashSet&lt;ObjectClassItem&lt;DateTime&gt;&gt; _objectClasses = new HashSet&lt;ObjectClassItem&lt;DateTime&gt;&gt;();&#xD;&#xA;private Dictionary&lt;Tuple&lt;string, string&gt;, int&gt; _matrix = new Dictionary&lt;Tuple&lt;string, string&gt;, int&gt;();&#xD;&#xA;private int _maxConflictsCount = 0;&#xD;&#xA;&#xD;&#xA;private void PilotReport_DataSourceDemanded(object sender, System.EventArgs e) &#xD;&#xA;{&#xD;&#xA;&#x9;var journalObjects = Parameters&#xD;&#xA;&#x9;&#x9;.OfType&lt;Parameter&gt;()&#xD;&#xA;&#x9;&#x9;.Select(x =&gt; x.Value as RObject)&#xD;&#xA;&#x9;&#x9;.Where(x =&gt; x != null &amp;&amp; x.Type.Name == BimSystemTypeNames.BIM_MODEL_CHECKER_CLASH_DETECTION_JOURNAL)&#xD;&#xA;&#x9;&#x9;.ToList();&#xD;&#xA;&#xD;&#xA;&#x9;if (!journalObjects.Any())&#xD;&#xA;&#x9;&#x9;throw new ReportExpectedException(&quot;Журнал не выбран.&quot;);&#xD;&#xA;&#x9;&#x9;&#xD;&#xA;&#x9;RObject coordinationModelObject = null;&#xD;&#xA;&#x9;var selectedJournalsSearchSets = journalObjects&#xD;&#xA;&#x9;&#x9;.SelectMany(journal =&gt; &#xD;&#xA;&#x9;&#x9;&#x9;&#x9;{&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;var leftSearchSetIds = GetRelationsByName(journal,BimSystemRelationNames.BIM_LEFT_SEARCH_SET_RELATIONS);&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;var rightSearchSetIds = GetRelationsByName(journal,BimSystemRelationNames.BIM_RIGHT_SEARCH_SET_RELATIONS);&#xD;&#xA;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;var searchSets = new List&lt;RObject&gt;();&#xD;&#xA;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;searchSets.AddRange(leftSearchSetIds.Select(x=&gt; GetSearchSetObj(x)));&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;searchSets.AddRange(rightSearchSetIds.Select(x=&gt; GetSearchSetObj(x)));&#xD;&#xA;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;var journalsFolderObject = journal.Parent;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;coordinationModelObject = journalsFolderObject.Parent;&#xD;&#xA;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;return searchSets;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;})&#xD;&#xA;&#x9;&#x9;.ToList();&#xD;&#xA;&#xD;&#xA;&#x9;FillReportHeaderAndFooter(journalObjects, coordinationModelObject, selectedJournalsSearchSets);&#xD;&#xA;&#x9;FillCollisionsMatrix(journalObjects);&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;private void FillReportHeaderAndFooter(List&lt;RObject&gt; journalObjects, RObject coordinationModelObject, List&lt;RObject&gt; searchSetObj)&#xD;&#xA;{&#xD;&#xA;&#x9;HeaderLabel.ForeColor = ColorScheme.AccentColor.ToDrawingColor();&#xD;&#xA;&#xD;&#xA;&#x9;ProjectNameLabel.Text = coordinationModelObject.Parent.Title;&#xD;&#xA;&#xD;&#xA;&#x9;ModelNameLabel.Text = coordinationModelObject.Title;&#xD;&#xA;&#xD;&#xA;&#x9;ModelNameLabel.NavigateUrl = Context.GetPilotUrl(coordinationModelObject.Id);&#xD;&#xA;&#xD;&#xA;&#x9;JournalsLabel.Text = string.Join(&#xD;&#xA;&#x9;&#x9;&quot;, &quot;, &#xD;&#xA;&#x9;&#x9;journalObjects.Select(x =&gt; x.Title));&#xD;&#xA;&#xD;&#xA;&#x9;SearchSetsLabel.Text = string.Join(&#xD;&#xA;&#x9;&#x9;&quot;, &quot;, &#xD;&#xA;&#x9;&#x9;new HashSet&lt;string&gt;(searchSetObj.Where(x=&gt; x != null).Select(x =&gt; x.Title)));&#xD;&#xA;&#xD;&#xA;&#x9;var currentUser = Context.CurrentPerson;&#xD;&#xA;&#x9;FooterInfoLabel.Text = string.Format(&#xD;&#xA;&#x9;&#x9;&quot;Отчёт построен {0:g} пользователем {1} ({2})&quot;,&#xD;&#xA;&#x9;&#x9;DateTime.Now.ToLocalTime(),&#xD;&#xA;&#x9;&#x9;currentUser.DisplayName,&#xD;&#xA;&#x9;&#x9;currentUser.MainPosition.Title);&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;private RObject GetSearchSetObj(Guid? nullableId)&#xD;&#xA;{&#x9;&#xD;&#xA;&#x9;if (!nullableId.HasValue) return null;&#x9;&#xD;&#xA;&#x9;return Context.GetObject(nullableId.Value);&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;private List&lt;Guid&gt; GetRelationsByName(RObject source, string relationName)&#xD;&#xA;{&#xD;&#xA;&#x9;var result = source.Relations&#xD;&#xA;&#x9;&#x9;.Where(x=&gt; x.Name == relationName)&#xD;&#xA;&#x9;&#x9;.Select(x=&gt; x.Target.Id)&#xD;&#xA;&#x9;&#x9;.ToList();&#xD;&#xA;&#xD;&#xA;&#x9;return result;&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;private void FillCollisionsMatrix(List&lt;RObject&gt; journalObjects)&#xD;&#xA;{&#xD;&#xA;&#x9;var repository = ContextWrapper.Instance.GetRepository();&#xD;&#xA;&#xD;&#xA;&#x9;var issueFoundState = repository.GetUserStates().FirstOrDefault(x =&gt; x.Name == &quot;bim_issueFound&quot;);&#xD;&#xA;&#x9;if (issueFoundState == null)&#xD;&#xA;&#x9;&#x9;throw new ReportExpectedException(&quot;Не удалось получить состояние пересечения \&quot;Найдено\&quot;&quot;);&#xD;&#xA;&#xD;&#xA;&#x9;foreach (var journalObject in journalObjects)&#xD;&#xA;&#x9;{&#xD;&#xA;&#x9;&#x9;var leftSearchSetIds = GetRelationsByName(journalObject , BimSystemRelationNames.BIM_LEFT_SEARCH_SET_RELATIONS);&#xD;&#xA;&#x9;&#x9;var rightSearchSetIds = GetRelationsByName(journalObject , BimSystemRelationNames.BIM_RIGHT_SEARCH_SET_RELATIONS);&#xD;&#xA;&#xD;&#xA;&#x9;&#x9;var leftObjects = leftSearchSetIds.Select(x=&gt; GetSearchSetObj(x));&#xD;&#xA;&#x9;&#x9;var rightObjects = rightSearchSetIds.Select(x=&gt; GetSearchSetObj(x));&#xD;&#xA;&#x9;&#xD;&#xA;&#x9;&#x9;var journalDataObject = DataObjects.Create(journalObject.GetSource().Source, repository.AsBackend());&#xD;&#xA;&#x9;&#x9;var results = BimReportJournalsService.Instance.GetCollisionResults(journalDataObject);&#xD;&#xA;&#xD;&#xA;&#x9;&#x9;foreach (var issue in results.Collisions)&#xD;&#xA;&#x9;&#x9;{ &#xD;&#xA;&#x9;&#x9;&#x9;if (issue.StateId != issueFoundState.Id)&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;continue;&#xD;&#xA;&#xD;&#xA;&#x9;&#x9;&#x9;AddConflict(&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;issue.FirstType,&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;leftObjects.First().CreatedUtc,&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;issue.SecondType,&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;rightObjects.First().CreatedUtc);&#x9;    &#xD;&#xA;&#x9;&#x9;}&#xD;&#xA;&#x9;}&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;private object TryGetValue(RObject source, string attrName)&#xD;&#xA;{&#xD;&#xA;&#x9;object value;&#xD;&#xA;&#x9;return source.Attributes.TryGetValue(attrName, out value)&#xD;&#xA;&#x9;&#x9;&#x9;? value&#xD;&#xA;&#x9;&#x9;&#x9;: null;&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;private Guid? TryGetGuidValue(RObject source, string attrName)&#xD;&#xA;{&#xD;&#xA;&#x9;var objValue = TryGetValue(source, attrName);&#xD;&#xA;&#xD;&#xA;&#x9;if(objValue == null)&#xD;&#xA;&#x9;&#x9;return null;&#xD;&#xA;&#xD;&#xA;&#x9;var guidValue = objValue as Guid?;&#xD;&#xA;&#x9;if(guidValue.HasValue)&#xD;&#xA;&#x9;&#x9;return guidValue;&#xD;&#xA;&#x9;&#xD;&#xA;&#x9;var strGuidValue = objValue as string;&#xD;&#xA;&#x9;Guid guid;&#xD;&#xA;&#x9;if(Guid.TryParse(strGuidValue, out guid))&#xD;&#xA;&#x9;&#x9;return guid;&#xD;&#xA;&#xD;&#xA;&#x9;return null;&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;private void OnConflictsMtrixBeforePrint(object sender, System.Drawing.Printing.PrintEventArgs e) &#xD;&#xA;{&#xD;&#xA;&#x9;var tab = (XRTable)sender;&#xD;&#xA;&#x9;var currentRow = ifcClassRow;&#xD;&#xA;&#x9;var currentCellIndex = 1;&#xD;&#xA;&#xD;&#xA;&#x9;var previousObjectClasses = new List&lt;string&gt;();&#xD;&#xA;&#x9;var objectClasses = _objectClasses&#xD;&#xA;&#x9;&#x9;.OrderBy(x =&gt; x.SortField)&#xD;&#xA;&#x9;&#x9;.ThenBy(x =&gt; x.LocalizedTitle)&#xD;&#xA;&#x9;&#x9;.ToList();&#xD;&#xA;&#xD;&#xA;&#x9;var lastObjectClass = objectClasses.LastOrDefault();&#xD;&#xA;&#xD;&#xA;&#x9;foreach (var objectClass in objectClasses)&#xD;&#xA;&#x9;{&#x9;&#x9;&#xD;&#xA;&#x9;&#x9;tab.Rows[0].Cells[currentCellIndex].Text = objectClass.LocalizedTitle;&#xD;&#xA;&#x9;&#x9;currentRow.Cells[0].Text = objectClass.LocalizedTitle;&#xD;&#xA;&#xD;&#xA;&#x9;&#x9;previousObjectClasses.Add(objectClass.ObjectClass);&#xD;&#xA;&#x9;&#x9;for (int i = 0; i &lt; previousObjectClasses.Count; i++)&#xD;&#xA;&#x9;&#x9;{&#xD;&#xA;&#x9;&#x9;&#x9;var mirrorCell = currentRow.Cells[i + 1];&#xD;&#xA;&#x9;&#x9;&#x9;mirrorCell.BackColor = System.Drawing.Color.Transparent;&#xD;&#xA;&#xD;&#xA;&#x9;&#x9;&#x9;var cell = tab.Rows[i + 1].Cells[currentCellIndex];&#xD;&#xA;&#xD;&#xA;&#x9;&#x9;&#x9;var secondObjectClass = previousObjectClasses[i];&#xD;&#xA;&#x9;&#x9;&#x9;var key = GetKey(objectClass.ObjectClass, secondObjectClass);&#xD;&#xA;&#x9;&#x9;&#x9;int conflictsCount;&#xD;&#xA;&#xD;&#xA;&#x9;&#x9;&#x9;if (_matrix.TryGetValue(key, out conflictsCount))&#xD;&#xA;&#x9;&#x9;&#x9;{&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;if (_maxConflictsCount &gt; 0)&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;{&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;var color = conflictsCount * 128 / _maxConflictsCount;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;if (color &gt;= 128)&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;color = 127;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;cell.BackColor = System.Drawing.Color.FromArgb(255, 127 + color, 168 - color, 0);&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;}&#xD;&#xA; &#xD;&#xA;&#x9;&#x9;&#x9;&#x9;cell.Text = conflictsCount.ToString();&#xD;&#xA;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;CopyCellStyle(conflictsCountCell, cell);&#xD;&#xA;&#x9;&#x9;&#x9;}&#xD;&#xA;&#x9;&#x9;&#x9;else&#xD;&#xA;&#x9;&#x9;&#x9;{&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;if (objectClass.ObjectClass == secondObjectClass)&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;{&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;cell.BackColor = System.Drawing.Color.Silver;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;}&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;else&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;{&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;cell.BackColor = System.Drawing.Color.Transparent;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;}&#xD;&#xA;&#x9;&#x9;&#x9;}&#xD;&#xA;&#x9;&#x9;}&#xD;&#xA;&#xD;&#xA;&#x9;&#x9;if (objectClass != lastObjectClass)&#xD;&#xA;&#x9;&#x9;{&#xD;&#xA;&#x9;&#x9;&#x9;currentRow = tab.InsertRowBelow(currentRow);&#x9;&#x9;&#xD;&#xA;&#x9;&#x9;&#x9;AddNewIfcClassCell(tab, currentCellIndex);&#xD;&#xA;&#x9;&#x9;&#x9;currentCellIndex++;&#xD;&#xA;&#x9;&#x9;}&#xD;&#xA;&#x9;}&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;private void AddConflict(string objectClass1, DateTime first, string objectClass2, DateTime second)&#xD;&#xA;{&#xD;&#xA;&#x9;_objectClasses.Add(new ObjectClassItem&lt;DateTime&gt;(objectClass1, first.ToLocalTime()));&#xD;&#xA;&#x9;_objectClasses.Add(new ObjectClassItem&lt;DateTime&gt;(objectClass2, second.ToLocalTime()));&#xD;&#xA;&#xD;&#xA;&#x9;var key = GetKey(objectClass1, objectClass2);&#xD;&#xA;&#xD;&#xA;&#x9;int currentCount;&#xD;&#xA;&#x9;var newCount = _matrix.TryGetValue(key, out currentCount)&#xD;&#xA;&#x9;&#x9;? currentCount + 1&#xD;&#xA;&#x9;&#x9;: 1;&#xD;&#xA;&#xD;&#xA;&#x9;_matrix[key] = newCount;&#xD;&#xA;&#xD;&#xA;&#x9;if (newCount &gt; _maxConflictsCount)&#xD;&#xA;&#x9;{&#xD;&#xA;&#x9;&#x9;_maxConflictsCount = newCount;&#xD;&#xA;&#x9;}&#x9;&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;public class ObjectClassItem&lt;T&gt;&#xD;&#xA;{&#xD;&#xA;&#x9;public ObjectClassItem(string objectClass, T sortField)&#xD;&#xA;&#x9;{&#xD;&#xA;&#x9;&#x9;ObjectClass = objectClass;&#xD;&#xA;&#x9;&#x9;SortField = sortField;&#xD;&#xA;&#x9;&#x9;LocalizedTitle = ObjectClassLocalization.TryGetTitle(ObjectClass);&#xD;&#xA;&#x9;}&#xD;&#xA;&#xD;&#xA;&#x9;public string ObjectClass { get; private set; }&#xD;&#xA;&#x9;public string LocalizedTitle { get; private set; }&#xD;&#xA;&#x9;public T SortField { get; private set; }&#xD;&#xA;&#xD;&#xA;&#x9;public override int GetHashCode()&#xD;&#xA;&#x9;{&#xD;&#xA;&#x9;&#x9;return ObjectClass.GetHashCode();&#xD;&#xA;&#x9;}&#xD;&#xA;&#xD;&#xA;&#x9;public override bool Equals(object obj)&#xD;&#xA;&#x9;{&#xD;&#xA;&#x9;&#x9;var other = obj as ObjectClassItem&lt;T&gt;;&#xD;&#xA;&#x9;&#x9;return obj != null &amp;&amp; ObjectClass == other.ObjectClass;&#xD;&#xA;&#x9;}&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;private Tuple&lt;string, string&gt; GetKey(string objectClass1, string objectClass2)&#xD;&#xA;{&#xD;&#xA;&#x9;var key = objectClass1.CompareTo(objectClass2) &gt; 0 &#xD;&#xA;&#x9;&#x9;? new Tuple&lt;string, string&gt;(objectClass1, objectClass2)&#xD;&#xA;&#x9;&#x9;: new Tuple&lt;string, string&gt;(objectClass2, objectClass1);&#xD;&#xA;&#xD;&#xA;&#x9;return key;&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;private void AddNewIfcClassCell(XRTable tab, int currentCellIndex)&#xD;&#xA;{&#xD;&#xA;&#x9;var cell = tab.InsertColumnToRight(tab.Rows[0].Cells[currentCellIndex], true)[0];&#xD;&#xA;&#x9;CopyCellStyle(ifcClassCell, cell);&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;private void CopyCellStyle(XRTableCell from, XRTableCell to)&#xD;&#xA;{&#xD;&#xA;&#x9;to.Angle = from.Angle;      &#xD;&#xA;&#x9;to.TextAlignment = from.TextAlignment;&#xD;&#xA;&#x9;to.TextFitMode = from.TextFitMode;&#xD;&#xA;&#x9;from.TextTrimming = from.TextTrimming;&#xD;&#xA;&#x9;to.CanGrow = from.CanGrow;&#xD;&#xA;&#x9;to.CanShrink = from.CanShrink;&#xD;&#xA;&#x9;to.Font = from.Font;&#xD;&#xA;&#x9;to.ForeColor = from.ForeColor;&#xD;&#xA;&#x9;to.Multiline = from.Multiline;&#xD;&#xA;&#x9;to.Padding = from.Padding;&#xD;&#xA;&#x9;to.Borders = from.Borders;&#xD;&#xA;&#x9;to.BorderColor = from.BorderColor;&#xD;&#xA;&#x9;to.BorderDashStyle = from.BorderDashStyle;&#xD;&#xA;&#x9;to.BorderWidth = from.BorderWidth;&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;public class ObjectClassLocalization&#xD;&#xA;{&#xD;&#xA;&#x9;public static string TryGetTitle(string objectCalss)&#xD;&#xA;&#x9;{&#xD;&#xA;&#x9;&#x9;if (_localization == null)&#xD;&#xA;&#x9;&#x9;&#x9;InitLocalizationDictionary();&#xD;&#xA;&#x9;&#x9;&#xD;&#xA;&#x9;&#x9;string value = null;&#xD;&#xA;&#x9;&#x9;return _localization.TryGetValue(objectCalss, out value)&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;? value&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;: objectCalss;&#xD;&#xA;&#x9;}&#xD;&#xA;&#x9;&#xD;&#xA;&#x9;private static void InitLocalizationDictionary()&#xD;&#xA;&#x9;{&#xD;&#xA;&#x9;&#x9;_localization = new Dictionary&lt;string, string&gt;();&#xD;&#xA;&#x9;&#x9;var localizationLines = _objectClassesLocalization&#xD;&#xA;&#x9;&#x9;&#x9;.Split(new[] { Environment.NewLine }, StringSplitOptions.RemoveEmptyEntries)&#xD;&#xA;&#x9;&#x9;&#x9;.Select(x =&gt; x.Split(',').ToArray())&#xD;&#xA;&#x9;&#x9;&#x9;.ToArray();&#xD;&#xA;&#x9;&#xD;&#xA;&#x9;&#x9;foreach (var line in localizationLines)&#xD;&#xA;&#x9;&#x9;{&#xD;&#xA;&#x9;&#x9;&#x9;var key = line.Count() &gt; 0 ? line[0] : null;&#xD;&#xA;&#x9;&#x9;&#x9;var value = line.Count() &gt; 1 ? line[1] : null;&#xD;&#xA;&#x9;&#x9;&#x9;&#xD;&#xA;&#x9;&#x9;&#x9;if (key == null || value == null)&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;continue;&#xD;&#xA;&#x9;&#x9;&#x9;&#xD;&#xA;&#x9;&#x9;&#x9;_localization[key] = value;&#xD;&#xA;&#x9;&#x9;}&#xD;&#xA;&#x9;}&#xD;&#xA;&#x9;&#xD;&#xA;&#xD;&#xA;private static Dictionary&lt;string, string&gt; _localization;&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;private static string _objectClassesLocalization = @&quot;&#xD;&#xA;IfcAirTerminal,Воздухораспределители&#xD;&#xA;IfcAnnotation,Типовые аннотации&#xD;&#xA;IfcBeam,Каркас несущий&#xD;&#xA;IfcBoiler,Оборудование&#xD;&#xA;IfcBuildingElementPart,Части&#xD;&#xA;IfcBuildingElementProxy,Обобщенные модели&#xD;&#xA;IfcCableCarrierFitting,Соединительные детали кабельных лотков&#xD;&#xA;IfcCableCarrierSegment,Кабельные лотки&#xD;&#xA;IfcColumn,Колонны&#xD;&#xA;IfcController,Специальное оборудование&#xD;&#xA;IfcCovering,Отделка&#xD;&#xA;IfcCurtainWall,Витражные системы&#xD;&#xA;IfcDiscreteAccessory,Специальное оборудование&#xD;&#xA;IfcDistributionFlowElement,Оборудование&#xD;&#xA;IfcDoor,Двери&#xD;&#xA;IfcDuctFitting,Соединительные детали воздуховодов&#xD;&#xA;IfcDuctSegment,Воздуховоды&#xD;&#xA;IfcElectricAppliance,Электрические приборы&#xD;&#xA;IfcEnergyConversionDevice,Отопительные приборы&#xD;&#xA;IfcFan,Вентиляторы&#xD;&#xA;IfcFastener,Соединения несущих конструкций&#xD;&#xA;IfcFireSuppressionTerminal,Спринклеры&#xD;&#xA;IfcFlowController,Устройство для контроля потока&#xD;&#xA;IfcFlowMovingDevice,Устройства перемещения потока (насосы, вентиляторы)&#xD;&#xA;IfcFlowStorageDevice,Специальное оборудование&#xD;&#xA;IfcFlowTerminal,Конечное оборудование систем&#xD;&#xA;IfcFlowFitting,Соединительные детали воздуховодов&#xD;&#xA;IfcFlowSegment,Воздуховоды&#xD;&#xA;IfcFooting,Фундамент несущей конструкции&#xD;&#xA;IfcFurnishingElement,Элемент мебели&#xD;&#xA;IfcFurniture,Мебель&#xD;&#xA;IfcGeographicElement,Генплан&#xD;&#xA;IfcLamp,Источники света&#xD;&#xA;IfcLightFixture,Осветительные приборы&#xD;&#xA;IfcMechanicalFastener,Механические крепления&#xD;&#xA;IfcMember,Каркас несущий&#xD;&#xA;IfcOpeningElement,Проёмы&#xD;&#xA;IfcPile,Фундамент несущей конструкции&#xD;&#xA;IfcPipeFitting,Соединительные детали трубопроводов&#xD;&#xA;IfcPipeSegment,Трубы&#xD;&#xA;IfcPlate,Каркас несущий&#xD;&#xA;IfcPump,Оборудование&#xD;&#xA;IfcRailing,Ограждение&#xD;&#xA;IfcRamp,Пандус&#xD;&#xA;IfcRampFlight,Пандус секция&#xD;&#xA;IfcReinforcingBar,Несущая арматура&#xD;&#xA;IfcReinforcingMesh,Области раскладки арматурных сеток&#xD;&#xA;IfcRoof,Крыши&#xD;&#xA;IfcSanitaryTerminal,Сантехнические приборы&#xD;&#xA;IfcSensor,Датчики&#xD;&#xA;IfcSite,Участок&#xD;&#xA;IfcSlab,Перекрытия&#xD;&#xA;IfcSpace,Помещения&#xD;&#xA;IfcSpaceHeater,Обогреватели&#xD;&#xA;IfcStair,Лестницы&#xD;&#xA;IfcStairFlight,Лестничные марши&#xD;&#xA;IfcSwitchingDevice,Выключатели электрических цепей&#xD;&#xA;IfcSystemFurnitureElement,Мебель&#xD;&#xA;IfcTank,Резервуары&#xD;&#xA;IfcTransportElement,Объекты транспорта&#xD;&#xA;IfcValve,Арматура трубопроводов&#xD;&#xA;IfcWall,Стены&#xD;&#xA;IfcWallStandardCase,Стандартные стены&#xD;&#xA;IfcWindow,Окна&#xD;&#xA;&quot;;&#xD;&#xA;&#xD;&#xA;}&#xD;&#xA;" Margins="35, 35, 75, 75" PaperKind="A4" PageWidth="827" PageHeight="1169" Version="20.1" DataSource="#Ref-0" Font="Segoe UI, 9.75pt, charSet=204">
