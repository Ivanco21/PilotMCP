<?xml version="1.0" encoding="utf-8"?>
<XtraReportsLayoutSerializer SerializerVersion="20.1.8.0" Ref="1" ControlType="Ascon.Pilot.Pilot.Reports.PilotReport, Ascon.Pilot.Pilot, Version=0.0.0.0, Culture=neutral, PublicKeyToken=null" Name="PilotReport" ScriptsSource="using Ascon.Pilot.ProjectionsRepository;&#xD;&#xA;using Ascon.Pilot.ClientCore.Search;&#xD;&#xA;using System.IO;&#xD;&#xA;using System.Linq;&#xD;&#xA;using System.Collections.Generic;&#xD;&#xA;using System.Data;&#xD;&#xA;using Ascon.Pilot.Core;&#xD;&#xA;using Ascon.Pilot.Client;&#xD;&#xA;using Ascon.Pilot.Client.Search;&#xD;&#xA;using Ascon.Pilot.Common.Search;&#xD;&#xA;using Ascon.Pilot.Pilot.Reports;&#xD;&#xA;using Ascon.Pilot.DataClasses;&#xD;&#xA;using Ascon.Pilot.XpsRender.Annotations;&#xD;&#xA;using Ascon.Pilot.DataModifier.Objects;&#xD;&#xA;using Ascon.Pilot.XpsRender.Annotations.Chat;&#xD;&#xA;using System.Xml.Serialization;&#xD;&#xA;using DevExpress.XtraReports.Parameters;&#xD;&#xA;using Annotation = System.Windows.Annotations.Annotation;&#xD;&#xA;&#xD;&#xA;ReportContext _context = new ReportContext();&#xD;&#xA;List&lt;INUserState&gt; _states = new List&lt;INUserState&gt;();&#xD;&#xA;&#xD;&#xA;private void PilotReport_DataSourceDemanded(object sender, System.EventArgs e) &#xD;&#xA;{&#xD;&#xA;&#x9;AnnotationsDetailReport.DataMember = &quot;Annotations&quot;;&#xD;&#xA;&#xD;&#xA;&#x9;var repository = ContextWrapper.Instance.GetRepository();&#xD;&#xA;&#xD;&#xA;      var remarksFolderType  = repository.GetType(&quot;doc_remarksFolder&quot;);&#x9;&#x9;&#xD;&#xA;&#x9;var remarkTypes = remarksFolderType.Children.ToArray();&#xD;&#xA;&#xD;&#xA;&#x9;_states = repository.GetUserStates().ToList();&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;&#x9;LongRunning.Start(this, () =&gt; {&#xD;&#xA;&#x9;&#x9;var project = Parameters[&quot;Project&quot;].Value as RObject;&#x9;&#xD;&#xA;&#x9;&#x9;if (project == null)&#xD;&#xA;&#x9;&#x9;&#x9;throw new ReportException(&quot;Проект не выбран&quot;);&#xD;&#xA;&#xD;&#xA;&#x9;&#x9;if (project.Type.Name == SystemTypes.SHORTCUT)&#xD;&#xA;&#x9;&#x9;{&#xD;&#xA;&#x9;&#x9;&#x9;project = GetRealObject(project);&#xD;&#xA;&#x9;&#x9;&#x9;Parameters[&quot;Project&quot;].Value = project;&#xD;&#xA;&#x9;&#x9;}&#xD;&#xA;&#xD;&#xA;&#x9;&#x9;var objectsBuilder = QueryBuilder.CreateEmptyQueryBuilder();&#xD;&#xA;&#x9;&#x9;var documentTypeIds = _context.GetTypes()&#xD;&#xA;&#x9;&#x9;&#x9;.Where(x =&gt; x.Children.Any(c =&gt; c.Id == remarksFolderType.Id))&#xD;&#xA;&#x9;&#x9;&#x9;.Select(x =&gt; x.Id)&#xD;&#xA;&#x9;&#x9;&#x9;.ToArray();&#x9;&#xD;&#xA;&#x9;&#x9;objectsBuilder.Must(ObjectFields.TypeId.BeAnyOf(documentTypeIds));&#xD;&#xA;&#x9;&#x9;var documents = _context.GetObjects(objectsBuilder, project.Id);&#xD;&#xA;&#x9;&#x9;var documentsById = documents.ToDictionary(x =&gt; x.Id);&#xD;&#xA;&#x9;&#x9;var remarkFolderIds = documents&#xD;&#xA;&#x9;&#x9;&#x9;.Select(x =&gt; x.GetSource())&#xD;&#xA;&#x9;&#x9;&#x9;.Where(x =&gt; x.Children.Any())&#xD;&#xA;&#x9;&#x9;&#x9;.SelectMany(x =&gt; x.Children.Where(c =&gt; c.TypeId == remarksFolderType.Id))&#xD;&#xA;&#x9;&#x9;&#x9;.Select(x =&gt; x.ObjectId)&#xD;&#xA;&#x9;&#x9;&#x9;.ToList();&#xD;&#xA;&#x9;&#x9;&#xD;&#xA;&#x9;&#x9;var remarkFolders = _context.GetObjects(remarkFolderIds).ToList();&#xD;&#xA;&#xD;&#xA;&#x9;&#x9;var remarkFoldersById = remarkFolders.ToDictionary(x =&gt; x.Id);&#x9;&#x9;&#xD;&#xA;&#xD;&#xA;&#x9;&#x9;var remarkIds = remarkFolders.SelectMany(rf =&gt; rf.GetSource().Children.Select(c =&gt; c.ObjectId)).ToList();&#xD;&#xA;&#x9;&#x9;var remarks = _context.GetObjects(remarkIds);&#xD;&#xA;&#x9;&#x9;var actualRemarksByDocument = new Dictionary&lt;RObject, List&lt;ReportAnnotation&gt;&gt;();&#xD;&#xA;&#x9;&#x9;foreach(var remark in remarks)&#xD;&#xA;&#x9;&#x9;{&#xD;&#xA;&#x9;&#x9;&#x9;var document = documentsById[remarkFoldersById[remark.GetSource().Parent.Id].GetSource().Parent.Id];&#xD;&#xA;&#x9;&#x9;&#x9;var lastVersion = document.ActualFilesSnapshot.Created;&#xD;&#xA;&#x9;&#x9;&#x9;if(!IsOfVersion(remark, lastVersion))&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;continue;&#xD;&#xA;&#x9;&#x9;&#x9;var reportAnnotation = ToAnnotation(remark);&#xD;&#xA;&#x9;&#x9;&#x9;List&lt;ReportAnnotation&gt; annotations;&#xD;&#xA;&#x9;&#x9;&#x9;if(!actualRemarksByDocument.TryGetValue(document, out annotations))&#xD;&#xA;&#x9;&#x9;&#x9;{&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;annotations = new List&lt;ReportAnnotation&gt;();&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;actualRemarksByDocument[document] = annotations;&#xD;&#xA;&#x9;&#x9;&#x9;}&#xD;&#xA;&#x9;&#x9;&#x9;annotations.Add(reportAnnotation);&#xD;&#xA;&#x9;&#x9;}&#x9;&#x9;&#xD;&#xA;&#x9;&#x9;&#xD;&#xA;&#x9;&#x9;DataSource = actualRemarksByDocument&#xD;&#xA;&#x9;&#x9;&#x9;.Where(x =&gt; x.Value.Any())&#xD;&#xA;&#x9;&#x9;&#x9;.Select(x =&gt; &#xD;&#xA;&#x9;&#x9;&#x9;{&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;var parent = x.Key.GetSource().Parent;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;var document = new ReportDocument()&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;{&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;Title = GetTitle(x.Key),&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;ParentId = parent.Id,&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;ParentTitle = GetTitle(x.Key.Parent)&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;};&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;document.Annotations.AddRange(x.Value);&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;return document;&#xD;&#xA;&#x9;&#x9;&#x9;}).ToList();&#xD;&#xA;&#x9;});&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;private RObject GetRealObject(RObject shortCutObj)&#xD;&#xA;{&#xD;&#xA;&#x9;object idValue;&#xD;&#xA;&#x9;Guid realObjId;&#xD;&#xA;&#x9;shortCutObj.Attributes.TryGetValue(SystemAttributes.SHORTCUT_OBJECT_ID, out idValue);&#xD;&#xA;&#x9;if (Guid.TryParse(idValue.ToString(), out realObjId))&#xD;&#xA;      {&#xD;&#xA;&#x9;&#x9;var realObj = _context.GetObject(realObjId);&#xD;&#xA;&#x9;&#x9;if (!realObj.IsInRecycleBin)&#xD;&#xA;&#x9;&#x9;&#x9;return realObj;&#xD;&#xA;      }&#xD;&#xA;&#x9;throw new ReportException(&quot;Не удалось получить проект, на который ссылается ярлык. Возможно проект находится в корзине.&quot;);&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;private bool IsOfVersion(RObject annotation, DateTime version)&#xD;&#xA;{&#xD;&#xA;&#x9;var ticks = version.ToUniversalTime().Ticks.ToString();&#xD;&#xA;&#x9;var belongsToVersion = annotation.Attributes.Any(x=&gt;x.Key.EndsWith(ticks));&#xD;&#xA;&#x9;return belongsToVersion;&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;private string GetTitle(RObject obj)&#xD;&#xA;{&#xD;&#xA;&#x9;return string.Format(&quot;{0}({1})&quot;, obj.Title, obj.Type.Title);&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;private ReportAnnotation ToAnnotation(RObject obj)&#xD;&#xA;{&#xD;&#xA;      var annotation = new ReportAnnotation ();&#xD;&#xA;&#x9;annotation.UserName = obj.Creator != null ? obj.Creator.DisplayName : null;&#xD;&#xA;&#x9;annotation.Date = obj.CreatedUtc.ToLocalTime();&#xD;&#xA;&#x9;annotation.Text = obj.Title;&#x9;&#xD;&#xA;&#x9;annotation.Type = obj.Type.Title;&#x9;&#x9;&#xD;&#xA;&#xD;&#xA;&#x9;var annotationValue = obj.Attributes.ContainsKey(&quot;annotation&quot;)&#xD;&#xA;&#x9;&#x9;? obj.Attributes[&quot;annotation&quot;] as string&#xD;&#xA;&#x9;&#x9;: null;&#xD;&#xA;&#xD;&#xA;&#x9;if(annotationValue != null)&#xD;&#xA;&#x9;{&#xD;&#xA;&#x9;      List&lt;AnnotationContainer&gt; annotationContainer = null;&#xD;&#xA;&#x9;      using (var reader = new StringReader(annotationValue))&#xD;&#xA;&#x9;      {&#xD;&#xA;&#x9;&#x9;&#x9;annotationContainer = Ascon.Pilot.Common.Annotations.AnnotationSerializers.AnnotationSerializer.Deserialize(reader) as List&lt;AnnotationContainer&gt;;&#xD;&#xA;&#x9;      }&#xD;&#xA;&#xD;&#xA;&#x9;&#x9;if(annotationContainer != null)&#xD;&#xA;&#x9;&#x9;{&#xD;&#xA;&#x9;&#x9;&#x9;var container = annotationContainer.OrderBy(x=&gt;x.Version).LastOrDefault();&#xD;&#xA;&#x9;&#x9;&#x9;if(container.Kind == AnnotationContainer.RED_PENCIL_NAME)&#xD;&#xA;&#x9;&#x9;&#x9;{&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;var pencilData =  container.ReadData&lt;PencilData&gt;();&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;if(!pencilData.IsTextNoteVisible)&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;annotation.Text = &quot;&lt;графическое замечание&gt;&quot;;&#xD;&#xA;&#x9;&#x9;&#x9;}&#xD;&#xA;&#x9;&#x9;}&#xD;&#xA;&#x9;}&#xD;&#xA;&#xD;&#xA;&#x9;var stateId = obj.Attributes.ContainsKey(&quot;state&quot;)&#xD;&#xA;&#x9;&#x9;? obj.Attributes[&quot;state&quot;] as Guid?&#xD;&#xA;&#x9;&#x9;: null;&#xD;&#xA;&#xD;&#xA;&#x9;var state = stateId.HasValue &#xD;&#xA;&#x9;&#x9;? _states.FirstOrDefault(x=&gt;x.Id == stateId.Value)&#xD;&#xA;&#x9;&#x9;: null;&#xD;&#xA;&#xD;&#xA;&#x9;annotation.Status = state != null&#xD;&#xA;&#x9;&#x9;? state.Title&#xD;&#xA;&#x9;&#x9;: null;&#xD;&#xA;&#xD;&#xA;&#x9;return annotation;&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;public class ReportDocument&#xD;&#xA;{&#xD;&#xA;&#x9;public string Title { get; set; }&#xD;&#xA;&#x9;public Guid ParentId { get; set; }&#xD;&#xA;&#x9;public string ParentTitle { get; set; }&#xD;&#xA;&#x9;public List&lt;ReportAnnotation&gt; Annotations { get; private set; }&#xD;&#xA; &#x9;&#xD;&#xA;&#x9;public ReportDocument()&#xD;&#xA;&#x9;{&#xD;&#xA;&#x9;&#x9;Annotations = new List&lt;ReportAnnotation&gt;();&#xD;&#xA;&#x9;}&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;public class ReportAnnotation &#xD;&#xA;{&#xD;&#xA;&#x9;public string UserName { get; set; }&#xD;&#xA;&#x9;public DateTime Date { get; set; }&#xD;&#xA;&#x9;public string Text { get; set; }&#xD;&#xA;&#x9;public string Status { get; set; }&#xD;&#xA;&#x9;public string Type { get; set; }&#xD;&#xA;&#xD;&#xA;&#x9;&#xD;&#xA;&#x9;public ReportAnnotation()&#xD;&#xA;&#x9;{&#xD;&#xA;&#x9;}&#xD;&#xA;}" Landscape="true" Margins="100, 100, 44, 49" PaperKind="A4" PageWidth="1169" PageHeight="827" Version="20.1" DataSource="#Ref-0">
