<?xml version="1.0" encoding="utf-8"?>
<XtraReportsLayoutSerializer SourceReportTypesNames="bim_coordinationModel; bim_modelPart" SerializerVersion="20.1.8.0" Ref="1" ControlType="Ascon.Pilot.Pilot.Reports.PilotReport, Ascon.Pilot.Pilot, Version=0.0.0.0, Culture=neutral, PublicKeyToken=null" Name="PilotReport" ScriptsSource="using Ascon.Pilot.Common.Search;&#xD;&#xA;using Ascon.Pilot.ClientCore.Search;&#xD;&#xA;using Ascon.Pilot.DataClasses;&#xD;&#xA;using System.Linq;&#xD;&#xA;using System.Collections.Generic;&#xD;&#xA;using Ascon.Pilot.ProjectionsRepository;&#xD;&#xA;using Ascon.Pilot.Theme.ColorScheme;&#xD;&#xA;using Ascon.Pilot.Pilot.Reports;&#xD;&#xA;using DevExpress.XtraReports.Parameters;&#xD;&#xA;using Ascon.Pilot.BimViewer.Reports;&#xD;&#xA;using Ascon.Pilot.PluginLoader.CrossDomainObjects;&#xD;&#xA;using Ascon.Pilot.BimUtils;&#xD;&#xA;using Ascon.Pilot.Client;&#xD;&#xA;using Ascon.Pilot.SDK;&#xD;&#xA;using System.Threading;&#xD;&#xA;using System.Threading.Tasks;&#xD;&#xA;using Ascon.Pilot.Bim.SDK.ModelStorage;&#xD;&#xA;using Ascon.Pilot.Bim.SDK;&#xD;&#xA;using Ascon.Pilot.Bim.SDK.Search;&#xD;&#xA;using Ascon.Pilot.Bim.Search.SDK;&#xD;&#xA;using Ascon.Pilot.Bim.Search.SDK.ModelProperties;&#xD;&#xA;using Ascon.Pilot.Bim.Search.SDK.Builders;&#xD;&#xA;using Ascon.Pilot.Bim.Search.SDK.Serialization;&#xD;&#xA;&#xD;&#xA;ReportContext Context = new ReportContext();&#xD;&#xA;&#xD;&#xA;private void PilotReport_DataSourceDemanded(object sender, System.EventArgs e) &#xD;&#xA;{&#xD;&#xA;&#x9;var modelLoadingParams = CoordinationModelLoadingParams.GetFromReportParams(Parameters);&#xD;&#xA;&#x9;&#xD;&#xA;&#x9;var modelStorage = LoadModelStorage(modelLoadingParams);&#xD;&#xA;    &#x9;using (var searchService = LoadModelSearchService(modelLoadingParams.ModelPartsForReport.Select(x =&gt; x.Id)))&#xD;&#xA;&#x9;{&#xD;&#xA;&#x9;&#x9;FillReportHeaderAndFooter(modelStorage.GetVersions().Last(), modelLoadingParams);&#xD;&#xA;&#x9;&#x9;FillReportDataSource(modelStorage, searchService, modelLoadingParams);&#xD;&#xA;&#x9;}&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;private void FillReportHeaderAndFooter(DateTime actualVer, CoordinationModelLoadingParams modelLoadingParams)&#xD;&#xA;{&#xD;&#xA;&#x9;HeaderLabel.ForeColor = ColorScheme.AccentColor.ToDrawingColor();&#xD;&#xA;&#x9;DetailHeader.BackColor = ColorScheme.AccentColor.ToDrawingColor();&#xD;&#xA;&#xD;&#xA;&#x9;ProjectNameLabel.Text = modelLoadingParams.Project.Title;&#xD;&#xA;&#xD;&#xA;&#x9;ModelNameLabel.Text = string.Format(&#xD;&#xA;&#x9;&#x9;&quot;{0} от {1:g}&quot;,&#xD;&#xA;&#x9;&#x9;modelLoadingParams.CoordModel.Title,&#xD;&#xA;&#x9;&#x9;actualVer.ToLocalTime());&#xD;&#xA;&#xD;&#xA;&#x9;ModelNameLabel.NavigateUrl = Context.GetPilotUrl(modelLoadingParams.CoordModel.Id);&#xD;&#xA;&#xD;&#xA;&#x9;ModelPartsLabel.Text = string.Join(&#xD;&#xA;&#x9;&#x9;&quot;, &quot;,&#xD;&#xA;&#x9;&#x9;modelLoadingParams.ModelPartsForReport.Select(x =&gt; x.Title).OrderBy(x =&gt; x));&#xD;&#xA;&#xD;&#xA;&#x9;var currentUser = new ReportContext().CurrentPerson;&#xD;&#xA;&#x9;FooterInfoLabel.Text = string.Format(&#xD;&#xA;&#x9;&#x9;&quot;Отчёт построен {0:g} пользователем {1} ({2})&quot;,&#xD;&#xA;&#x9;&#x9;DateTime.Now.ToLocalTime(),&#xD;&#xA;&#x9;&#x9;currentUser.DisplayName,&#xD;&#xA;&#x9;&#x9;currentUser.MainPosition.Title);&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;private static RObject GetRealObject(RObject shortCutObj)&#xD;&#xA;{&#xD;&#xA;&#x9;object idValue;&#xD;&#xA;&#x9;Guid realdModelPartId;&#xD;&#xA;&#x9;shortCutObj.Attributes.TryGetValue(SystemAttributes.SHORTCUT_OBJECT_ID, out idValue);&#xD;&#xA;&#x9;if (Guid.TryParse(idValue.ToString(), out realdModelPartId))&#xD;&#xA;      {&#xD;&#xA;&#x9;&#x9;var realObj = new ReportContext().GetObject(realdModelPartId);&#xD;&#xA;&#x9;&#x9;if (!realObj.IsInRecycleBin)&#xD;&#xA;&#x9;&#x9;&#x9;return realObj;&#xD;&#xA;      }&#xD;&#xA;&#x9;return null;&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;private void FillReportDataSource(IModelStorage modelStorage, IModelSearchService modelSearchService, CoordinationModelLoadingParams modelLoadingParams)&#xD;&#xA;{&#xD;&#xA;&#x9;DataSource = modelLoadingParams.ModelPartsForReport&#xD;&#xA;&#x9;&#x9;.Select(x =&gt; &#xD;&#xA;&#x9;&#x9;&#x9;{&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;var modelPart = new ModelPartItem() &#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;{&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;Name = x.Title,&#xD;&#xA;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;Windows = GetElementsForModelPart(modelSearchService, x.Id, &quot;IfcWindow&quot;) &#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;.GroupBy(w =&gt; GetReferenceType(modelStorage, w, &quot;WindowCommon&quot;))&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;.Select(g =&gt; new IfcObjectItem() { TypeName = g.Key, Count = g.Count() })&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;.OrderBy(w =&gt; w.TypeName)&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;.ToList(),&#xD;&#xA;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;Doors = GetElementsForModelPart(modelSearchService, x.Id, &quot;IfcDoor&quot;)&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;.GroupBy(w =&gt; GetReferenceType(modelStorage, w, &quot;DoorCommon&quot;))&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;.Select(g =&gt; new IfcObjectItem() { TypeName = g.Key, Count = g.Count() })&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;.OrderBy(w =&gt; w.TypeName)&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;.ToList(),&#xD;&#xA;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;};&#xD;&#xA;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;if(!modelPart.Windows.Any())&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;{&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;modelPart.Windows = new List&lt;IfcObjectItem&gt;()&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;{&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;new IfcObjectItem() { TypeName = &quot;&lt;нет элементов&gt;&quot; }&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;};&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;}&#xD;&#xA;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;if(!modelPart.Doors.Any())&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;{&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;modelPart.Doors = new List&lt;IfcObjectItem&gt;()&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;{&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;new IfcObjectItem() { TypeName = &quot;&lt;нет элементов&gt;&quot; }&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;};&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;}&#xD;&#xA;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;return modelPart;&#xD;&#xA;&#x9;&#x9;&#x9;})&#xD;&#xA;&#x9;&#x9;.OrderBy(x =&gt; x.Name)&#xD;&#xA;&#x9;&#x9;.ToList();&#xD;&#xA;&#xD;&#xA;&#x9;WindowsDetailReport.DataMember = &quot;Windows&quot;;//имя поля класса ReportModelPart со списком окон&#xD;&#xA;&#x9;DoorsDetailReport.DataMember = &quot;Doors&quot;; //имя поля класса ReportModelPart со списком дверей&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;private List&lt;IModelElementId&gt; GetElementsForModelPart(IModelSearchService modelSearchService, Guid modelPartId, string ifcType)&#xD;&#xA;{&#xD;&#xA;      var expressionsBuilder = ModelSearchExpressionsBuilder.CreateBuilder();&#xD;&#xA;      expressionsBuilder.AddExpression(Property.ModelPartId.EqualTo(modelPartId));&#xD;&#xA;      expressionsBuilder.AddExpression(Property.Type.EqualTo(ifcType));&#xD;&#xA;&#xD;&#xA;      var searchSetBuilder = ModelSearchSetBuilder.CreateBuilder(SearchSetLogicalOperator.And);&#xD;&#xA;      searchSetBuilder.AddExpressions(expressionsBuilder);&#xD;&#xA;&#xD;&#xA;&#x9;return modelSearchService.Search(searchSetBuilder.Build(), 10000).ToList();&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;private IModelStorage LoadModelStorage(CoordinationModelLoadingParams modelLoadingParams)&#xD;&#xA;{&#xD;&#xA;&#x9;IModelStorage modelStorage = null;&#xD;&#xA;&#x9;LongRunning.Start(&#xD;&#xA;&#x9;&#x9;this, &#xD;&#xA;&#x9;&#x9;() =&gt; {&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;modelStorage = BimReportService.GetModelStorage(modelLoadingParams.CoordModel.Id);&#xD;&#xA;&#x9;&#x9;&#x9;});&#xD;&#xA;&#xD;&#xA;&#x9;return modelStorage;&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;private IModelSearchService LoadModelSearchService(IEnumerable&lt;Guid&gt; modelPartsIds)&#xD;&#xA;{&#xD;&#xA;&#x9;IModelSearchService searchService = null;&#xD;&#xA;&#x9;LongRunning.Start(&#xD;&#xA;&#x9;&#x9;this, &#xD;&#xA;&#x9;&#x9;() =&gt; {&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;searchService = BimReportService.GetModelSearchManger().GetModelPartsSearchServiceAsync(modelPartsIds).GetAwaiter().GetResult();&#xD;&#xA;&#x9;&#x9;&#x9;});&#xD;&#xA;&#xD;&#xA;&#x9;return searchService;&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;private string GetReferenceType(IModelStorage modelStorage, IModelElementId id, string pSetGroupName)&#xD;&#xA;{&#xD;&#xA;var actualVer = modelStorage.GetVersions().Last();&#xD;&#xA;var elementProperties = modelStorage.LoadElementProperties(id, actualVer);&#xD;&#xA;var propertySet = elementProperties.FirstOrDefault(p =&gt; p.Name.EndsWith(pSetGroupName, StringComparison.InvariantCultureIgnoreCase));&#xD;&#xA;if (propertySet != null)&#xD;&#xA;{&#xD;&#xA;&#x9;var property = propertySet.Properties.FirstOrDefault(v =&gt; string.Equals(v.Name, &quot;Reference&quot;, StringComparison.InvariantCultureIgnoreCase));&#x9;&#xD;&#xA;&#x9;if (property != null)&#xD;&#xA;&#x9;return property.Value.ToString();&#xD;&#xA;}&#xD;&#xA;&#x9;return &quot;&lt;неизвестный тип&gt;&quot;;&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;class ModelPartItem&#xD;&#xA;{&#xD;&#xA;&#x9;public string Name { get; set; }&#xD;&#xA;&#x9;public List&lt;IfcObjectItem&gt; Windows { get; set; }&#xD;&#xA;&#x9;public List&lt;IfcObjectItem&gt; Doors { get; set; }&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;class IfcObjectItem&#xD;&#xA;{&#xD;&#xA;&#x9;public string TypeName { get; set; }&#xD;&#xA;&#x9;public int? Count { get; set; }&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;class CoordinationModelLoadingParams&#xD;&#xA;{&#xD;&#xA;&#x9;public RObject Project { get; private set; }&#xD;&#xA;&#x9;public RObject CoordModel { get; private set; }&#xD;&#xA;&#x9;public RObject[] ModelPartsForReport { get; private set; }&#xD;&#xA;&#xD;&#xA;&#x9;public static CoordinationModelLoadingParams GetFromReportParams(ParameterCollection reportParams)&#xD;&#xA;&#x9;{&#xD;&#xA;&#x9;&#x9;return GetFromReportParams(reportParams&#xD;&#xA;&#x9;&#x9;&#x9;.OfType&lt;Parameter&gt;()&#xD;&#xA;&#x9;&#x9;&#x9;.Select(x =&gt; x.Value as RObject));&#xD;&#xA;&#x9;}&#xD;&#xA;&#xD;&#xA;&#x9;public static CoordinationModelLoadingParams GetFromReportParams(IEnumerable&lt;RObject&gt; rObjects)&#xD;&#xA;&#x9;{&#xD;&#xA;&#x9;&#x9;//предполагаем, что в качестве параметров отчета могут быть переданы только RObject,&#xD;&#xA;&#x9;&#x9;//которые могут быть отдельными model part'ами, ярлыками или coordination model'ю целиком.&#xD;&#xA;&#x9;&#x9;var sourceObjects = rObjects.Where(x =&gt; x != null)&#xD;&#xA;&#x9;&#x9;&#x9;.ToList();&#xD;&#xA;&#xD;&#xA;&#x9;&#x9;//если в параметрах отчета пришли RObject'ы представляющие собой modelpart'ы или ярлыки..  &#xD;&#xA;&#x9;&#x9;var sourceModelParts = sourceObjects&#xD;&#xA;&#x9;&#x9;&#x9;.Where(x =&gt; x.Type.Name == BimSystemTypeNames.BIM_MODEL_PART || x.Type.Name == SystemTypes.SHORTCUT);&#xD;&#xA;&#xD;&#xA;&#x9;&#x9;var coordinationModel = sourceObjects&#xD;&#xA;&#x9;&#x9;&#x9;.Where(x =&gt; x.Type.Name == BimSystemTypeNames.BIM_COORDINATION_MODEL).FirstOrDefault();&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;&#x9;&#x9;//..то получаем их родительскую coordination model, чтобы строить отчет от неё.&#xD;&#xA;&#x9;&#x9;var sourceCoorinationModel = coordinationModel == null? FindCoordinationModel(sourceModelParts.First()) : coordinationModel;&#xD;&#xA;&#xD;&#xA;&#x9;&#x9;//и запоминаем идентификаторы выбранных частей модели или ярлыков&#xD;&#xA;&#x9;&#x9;var modelPartsToLoad = sourceModelParts;&#xD;&#xA;&#xD;&#xA;&#x9;&#x9;//если в пераметрах отчета не нашлось model part'ов или ярлыков,&#xD;&#xA;&#x9;&#x9;// и поэтому список coordination models пуст,&#xD;&#xA;&#x9;&#x9;// попробуем найти RObject типа coordination model&#xD;&#xA;&#x9;&#x9;// непосредственно в параметрах отчёта&#xD;&#xA;&#x9;&#x9;if (sourceCoorinationModel != null &amp;&amp; modelPartsToLoad.Count() == 0)&#xD;&#xA;&#x9;&#x9;{&#xD;&#xA;&#x9;&#x9;&#x9;//и выбираем идентификаторы всех частей модели и ярлыков&#xD;&#xA;&#x9;&#x9;&#x9;modelPartsToLoad = GetCoordinationModelChildrenRecursive(sourceCoorinationModel);&#xD;&#xA;&#x9;&#x9;}&#xD;&#xA;&#xD;&#xA;&#x9;&#x9;if(sourceCoorinationModel == null &amp;&amp; modelPartsToLoad.Count() == 0)&#xD;&#xA;&#x9;&#x9;{&#xD;&#xA;&#x9;&#x9;&#x9;throw new ReportExpectedException(&quot;В качестве параметра отчёта должна быть выбрана консолидированная модель, часть консолидированной модели или ярлык ссылающийся на неудаленный объект.&quot;);&#xD;&#xA;&#x9;&#x9;}&#xD;&#xA;&#x9;&#x9;&#xD;&#xA;&#xD;&#xA;&#x9;&#x9;// если нам пришли RObject'ы, представляющие собой ярлыки, то получим реальные объекты, на которые они ссылаются, чтобы строить отчет от них&#xD;&#xA;&#x9;&#x9;var modelPartsForReport = modelPartsToLoad.Select(x =&gt; x.Type.Name == SystemTypes.SHORTCUT ? GetRealObject(x) : x)&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;.Where(y=&gt; y != null).ToArray();&#xD;&#xA;&#x9;&#x9;&#xD;&#xA;&#x9;&#x9;if (!modelPartsForReport.Any())&#xD;&#xA;&#x9;&#x9;&#x9;throw new ReportExpectedException(&quot;В качестве параметра отчёта должна быть выбрана консолидированная модель, часть консолидированной модели или ярлык ссылающийся на неудаленный объект.&quot;);&#xD;&#xA;&#x9;&#x9;&#xD;&#xA;&#x9;&#x9;return new CoordinationModelLoadingParams()&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;{&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;Project = sourceCoorinationModel.Parent,&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;CoordModel = sourceCoorinationModel,&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;ModelPartsForReport = modelPartsForReport,&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;};&#xD;&#xA;&#x9;}&#xD;&#xA;&#xD;&#xA;&#x9;static List&lt;RObject&gt; GetCoordinationModelChildrenRecursive(RObject coordinationModelSource)&#xD;&#xA;    {&#xD;&#xA;            var result = new List&lt;RObject&gt;();&#xD;&#xA;            var queue = new Queue&lt;RObject&gt;();&#xD;&#xA;&#xD;&#xA;            FillQueue(queue, coordinationModelSource.Children, result);&#xD;&#xA;&#xD;&#xA;            while (queue.Any())&#xD;&#xA;            {&#xD;&#xA;                var folder = queue.Dequeue();&#xD;&#xA;                FillQueue(queue, folder.Children, result);&#xD;&#xA;            }&#xD;&#xA;&#xD;&#xA;            return result;&#xD;&#xA;    }&#xD;&#xA;&#xD;&#xA;    static void FillQueue(Queue&lt;RObject&gt; inQueue, IEnumerable&lt;RObject&gt; children, List&lt;RObject&gt; outResult)&#xD;&#xA;    {&#xD;&#xA;                foreach (var child in children)&#xD;&#xA;                {&#xD;&#xA;                    if (child.Type.Name == SystemTypes.SHORTCUT)&#xD;&#xA;                    {&#xD;&#xA;                    &#x9;var obj = GetRealObject(child);&#xD;&#xA;                    &#x9;outResult.Add(obj);&#xD;&#xA;                    }&#xD;&#xA;                    else if (child.Type.Name == BimSystemTypeNames.BIM_MODEL_PART)&#xD;&#xA;                    {&#xD;&#xA;                        outResult.Add(child);&#xD;&#xA;                    }&#xD;&#xA;                    else if (child.Type.Name == BimSystemTypeNames.BIM_MODEL_PART_FOLDER)&#xD;&#xA;                    {&#xD;&#xA;                        inQueue.Enqueue(child);&#xD;&#xA;                    }&#xD;&#xA;                }&#xD;&#xA;    }&#xD;&#xA;&#xD;&#xA;    static RObject FindCoordinationModel(RObject child)&#xD;&#xA;        {&#xD;&#xA;            var queue = new Queue&lt;RObject&gt;();&#xD;&#xA;            queue.Enqueue(child.Parent);&#xD;&#xA;&#xD;&#xA;            while (queue.Any())&#xD;&#xA;            {&#xD;&#xA;                var item = queue.Dequeue();&#xD;&#xA;&#xD;&#xA;                if (item.Type.Name == BimSystemTypeNames.BIM_COORDINATION_MODEL)&#xD;&#xA;                {&#xD;&#xA;                    return item;&#xD;&#xA;                }&#xD;&#xA;                else if (item.Type.Name == BimSystemTypeNames.BIM_MODEL_PART_FOLDER)&#xD;&#xA;                {&#xD;&#xA;                    queue.Enqueue(item.Parent);&#xD;&#xA;                }&#xD;&#xA;            }&#xD;&#xA;            return null;&#xD;&#xA;        }&#xD;&#xA;}" Margins="75, 75, 75, 75" PaperKind="A4" PageWidth="827" PageHeight="1169" Version="20.1" DataSource="#Ref-0" Font="Segoe UI, 9.75pt, charSet=204">
