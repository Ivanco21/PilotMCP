<?xml version="1.0" encoding="utf-8"?>
<XtraReportsLayoutSerializer SerializerVersion="20.1.8.0" Ref="1" ControlType="Ascon.Pilot.Pilot.Reports.PilotReport, Ascon.Pilot.Pilot, Version=0.0.0.0, Culture=neutral, PublicKeyToken=null" Name="PilotReport" ScriptsSource="using Ascon.Pilot.ProjectionsRepository;&#xD;&#xA;using Ascon.Pilot.ClientCore.Search;&#xD;&#xA;using Ascon.Pilot.DataClasses;&#xD;&#xA;using System.Drawing;&#xD;&#xA;using System.Linq;&#xD;&#xA;using System.Collections.Generic;&#xD;&#xA;using Ascon.Pilot.Core;&#xD;&#xA;using Ascon.Pilot.Client.Search;&#xD;&#xA;using Ascon.Pilot.Pilot.Reports;&#xD;&#xA;using DevExpress.XtraReports.Parameters;&#xD;&#xA;using DevExpress.XtraPrinting.Drawing;&#xD;&#xA;&#xD;&#xA;private ReportContext _context = new ReportContext();&#xD;&#xA;&#xD;&#xA;private void PilotReport_DataSourceDemanded(object sender, System.EventArgs e) &#xD;&#xA;{&#xD;&#xA;&#x9;var project = Parameters[&quot;Project&quot;].Value as RObject;&#xD;&#xA;&#x9;if (project == null)&#xD;&#xA;&#x9;&#x9;throw new ReportException(&quot;Не выбран проект&quot;);&#xD;&#xA;&#xD;&#xA;&#x9;if (project.Type.Name == SystemTypes.SHORTCUT)&#xD;&#xA;&#x9;{&#xD;&#xA;&#x9;&#x9;project = GetRealObject(project);&#xD;&#xA;&#x9;&#x9;Parameters[&quot;Project&quot;].Value = project;&#xD;&#xA;&#x9;}&#xD;&#xA;&#x9;&#xD;&#xA;&#x9;LongRunning.Start(this, () =&gt; {&#xD;&#xA;&#x9;&#x9;DataSource = CollectElements(project, string.Empty).ToList();&#xD;&#xA;&#x9;});&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;private RObject GetRealObject(RObject shortCutObj)&#xD;&#xA;{&#xD;&#xA;&#x9;object idValue;&#xD;&#xA;&#x9;Guid realObjId;&#xD;&#xA;&#x9;shortCutObj.Attributes.TryGetValue(SystemAttributes.SHORTCUT_OBJECT_ID, out idValue);&#xD;&#xA;&#x9;if (Guid.TryParse(idValue.ToString(), out realObjId))&#xD;&#xA;      {&#xD;&#xA;&#x9;&#x9;var realObj = _context.GetObject(realObjId);&#xD;&#xA;&#x9;&#x9;if (!realObj.IsInRecycleBin)&#xD;&#xA;&#x9;&#x9;&#x9;return realObj;&#xD;&#xA;      }&#xD;&#xA;&#x9;throw new ReportException(&quot;Не удалось получить проект, на который ссылается ярлык. Возможно проект находится в корзине.&quot;);&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;private IEnumerable&lt;Element&gt; CollectElements(RObject parent, string prefix)&#xD;&#xA;{&#xD;&#xA;&#x9;List&lt;Element&gt; result = new List&lt;Element&gt;();&#xD;&#xA;&#x9;int num = 0;&#xD;&#xA;&#x9;foreach(var child in parent.Children)&#xD;&#xA;&#x9;{&#xD;&#xA;&#x9;&#x9;var element = GetElement(child);&#xD;&#xA;&#x9;&#x9;if(element != null)&#xD;&#xA;&#x9;&#x9;{&#xD;&#xA;&#x9;&#x9;&#x9;num++;&#xD;&#xA;&#x9;&#x9;&#x9;result.Add(element);&#xD;&#xA;&#x9;&#x9;&#x9;element.Num = prefix + num;&#x9;&#x9;&#x9;&#x9;&#xD;&#xA;&#x9;&#x9;}&#xD;&#xA;&#x9;&#x9;result.AddRange(CollectElements(child, prefix + num + &quot;.&quot;));&#x9;&#xD;&#xA;&#x9;}&#xD;&#xA;&#x9;return result;&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;private Element GetElement(RObject obj)&#xD;&#xA;{&#xD;&#xA;&#x9;const string MAIN_SET_TYPE_NAME = &quot;main_set&quot;; &#xD;&#xA;&#x9;const string MAIN_SET_CODE_ATTRIBUTE_NAME = &quot;code&quot;;&#xD;&#xA;&#x9;const string MAIN_SET_NAME_ATTRIBUTE_NAME = &quot;name&quot;;&#xD;&#xA;&#x9;&#xD;&#xA;&#x9;const string BUILDING_TYPE_NAME = &quot;building&quot;;&#xD;&#xA;&#x9;const string BUILDING_NUMBER_ATTRIBUTE_NAME = &quot;number&quot;;&#xD;&#xA;&#x9;const string BUILDING_NAME_ATTRIBUTE_NAME = &quot;name&quot;;&#xD;&#xA;&#xD;&#xA;&#x9;if(obj.Type.Name == MAIN_SET_TYPE_NAME)&#xD;&#xA;&#x9;{&#xD;&#xA;&#x9;&#x9;return new Element&#xD;&#xA;&#x9;&#x9;{&#xD;&#xA;&#x9;&#x9;&#x9;Notation = GetStringAttributeValue(obj, MAIN_SET_CODE_ATTRIBUTE_NAME),&#xD;&#xA;&#x9;&#x9;&#x9;Name = GetStringAttributeValue(obj, MAIN_SET_NAME_ATTRIBUTE_NAME)&#x9;&#x9;&#xD;&#xA;&#x9;&#x9;};&#xD;&#xA;&#x9;}&#xD;&#xA;&#x9;if(obj.Type.Name == BUILDING_TYPE_NAME)&#xD;&#xA;&#x9;{&#xD;&#xA;&#x9;&#x9;return new Element&#xD;&#xA;&#x9;&#x9;{&#xD;&#xA;&#x9;&#x9;&#x9;Notation = GetStringAttributeValue(obj, BUILDING_NUMBER_ATTRIBUTE_NAME),&#xD;&#xA;&#x9;&#x9;&#x9;Name = GetStringAttributeValue(obj, BUILDING_NAME_ATTRIBUTE_NAME)&#x9;&#x9;&#x9;&#xD;&#xA;&#x9;&#x9;};&#xD;&#xA;&#x9;}&#xD;&#xA;&#x9;return null;&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;private string GetStringAttributeValue(RObject obj, string attributeName)&#xD;&#xA;{&#xD;&#xA;&#x9;object value;&#xD;&#xA;&#x9;if(!obj.Attributes.TryGetValue(attributeName, out value))&#xD;&#xA;&#x9;&#x9;return null;&#xD;&#xA;&#x9;return (string)value;&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;// На всех страницах кроме первой рисуем другую основную надпись с помощью водяного знака&#xD;&#xA;private void table1_PrintOnPage(object sender, DevExpress.XtraReports.UI.PrintOnPageEventArgs e) {&#xD;&#xA;&#x9;if(e.PageIndex &gt; 0)&#xD;&#xA;&#x9;{&#xD;&#xA;&#x9;&#x9;PilotReport.Pages[e.PageIndex].AssignWatermark(CreateWatermark());&#xD;&#xA;&#x9;}&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;// Количество страниц печатается только на 1 странице&#xD;&#xA;private void tbPageCount_PrintOnPage(object sender, DevExpress.XtraReports.UI.PrintOnPageEventArgs e) &#xD;&#xA;{&#xD;&#xA;&#x9;if(e.PageIndex &gt; 0)&#xD;&#xA;&#x9;&#x9;e.Cancel = true;&#x9;&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;// Позиционируем название проекта в основную надпись на страницах после первой&#xD;&#xA;private void tbProjectName_BeforePrint(object sender, System.Drawing.Printing.PrintEventArgs e) {&#xD;&#xA;&#x9;if(PrintingSystem.Document.PageCount &gt; 0)&#xD;&#xA;&#x9;{&#xD;&#xA;&#x9;&#x9;tbProjectName.Location = new Point(256, 104);&#xD;&#xA;&#x9;&#x9;tbProjectName.Size = new Size(428, 55); &#xD;&#xA;&#x9;}&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;// Позиционаруем номер листа в основную надпись на страницах после первой&#xD;&#xA;private void tbPage_BeforePrint(object sender, System.Drawing.Printing.PrintEventArgs e) &#xD;&#xA;{&#xD;&#xA;&#x9;if(PrintingSystem.Document.PageCount &gt; 0)&#xD;&#xA;&#x9;{&#xD;&#xA;&#x9;&#x9;tbPage.Location = new Point(684, 130);&#xD;&#xA;&#x9;&#x9;tbPage.Size = new Size(39, 29); &#xD;&#xA;&#x9;}&#xD;&#xA;&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;private Watermark CreateWatermark()&#xD;&#xA;{&#xD;&#xA;&#x9;var wm = new Watermark();&#xD;&#xA;&#x9;wm.Image = watermarkHolder.Image;&#xD;&#xA;&#x9;wm.ImageViewMode = ImageViewMode.Stretch;&#xD;&#xA;&#x9;wm.ShowBehind = true;&#xD;&#xA;&#x9;return wm;&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;class Element&#xD;&#xA;{&#xD;&#xA;&#x9;public string Num { get; set; }&#xD;&#xA;&#x9;public string Notation { get; set; }&#xD;&#xA;&#x9;public string Name { get; set; }&#xD;&#xA;&#x9;public string Comment { get; set; }&#xD;&#xA;}" DrawWatermark="true" Margins="80, 23, 20, 184" PaperKind="A4" PageWidth="827" PageHeight="1169" Version="20.1" DataSource="#Ref-0" Font="Arial, 11.25pt, charSet=204">
