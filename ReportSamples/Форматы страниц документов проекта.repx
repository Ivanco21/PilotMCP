<?xml version="1.0" encoding="utf-8"?>
<XtraReportsLayoutSerializer SerializerVersion="20.1.8.0" Ref="1" ControlType="Ascon.Pilot.Pilot.Reports.PilotReport, Ascon.Pilot.Pilot, Version=0.0.0.0, Culture=neutral, PublicKeyToken=null" Name="PilotReport" ScriptsSource="using Ascon.Pilot.ProjectionsRepository;&#xD;&#xA;using Ascon.Pilot.ClientCore.Search;&#xD;&#xA;using Ascon.Pilot.DataClasses;&#xD;&#xA;using System.Linq;&#xD;&#xA;using System.Xml.Linq;&#xD;&#xA;using System.IO;&#xD;&#xA;using System.Collections.Generic;&#xD;&#xA;using Ascon.Pilot.Core;&#xD;&#xA;using Ascon.Pilot.Client.Search;&#xD;&#xA;using Ascon.Pilot.Common.Search;&#xD;&#xA;using Ascon.Pilot.Pilot.Reports;&#xD;&#xA;using DevExpress.XtraReports.Parameters;&#xD;&#xA;using System.Text.RegularExpressions;&#xD;&#xA;using System.IO.Packaging;&#xD;&#xA;using System.Globalization;&#xD;&#xA;&#xD;&#xA;ReportContext _context = new ReportContext();&#xD;&#xA;Dictionary&lt;Guid, string&gt; paperSizeCache = new Dictionary&lt;Guid, string&gt;();&#xD;&#xA;&#xD;&#xA;private void PilotReport_DataSourceDemanded(object sender, System.EventArgs e) &#xD;&#xA;{&#xD;&#xA;&#x9;paperSizeCache.Clear();&#xD;&#xA;&#x9;&#xD;&#xA;&#x9;LongRunning.Start(this, () =&gt; {&#xD;&#xA;&#x9;&#x9;var project = Parameters[&quot;Project&quot;].Value as RObject;&#xD;&#xA;&#x9;&#x9;if (project == null)&#xD;&#xA;&#x9;&#x9;&#x9;throw new ReportException(&quot;Проект не выбран&quot;);&#xD;&#xA;&#xD;&#xA;&#x9;&#x9;if (project.Type.Name == SystemTypes.SHORTCUT)&#xD;&#xA;&#x9;&#x9;{&#xD;&#xA;&#x9;&#x9;&#x9;project = GetRealObject(project);&#xD;&#xA;&#x9;&#x9;&#x9;Parameters[&quot;Project&quot;].Value = project;&#xD;&#xA;&#x9;&#x9;}&#xD;&#xA;&#x9;&#x9;&#xD;&#xA;&#x9;&#x9;var documentTypes = _context.GetTypes().Where(x =&gt; x.HasFiles).Select(x =&gt; x.Id).ToArray();&#xD;&#xA;&#x9;&#x9;var objectsBuilder = QueryBuilder.CreateObjectQueryBuilder();&#x9;&#xD;&#xA;&#x9;&#x9;objectsBuilder.Must(ObjectFields.TypeId.BeAnyOf(documentTypes));&#x9;&#xD;&#xA;&#x9;&#x9;var objects = _context.GetObjects(objectsBuilder, project.Id); &#xD;&#xA;&#x9;&#x9;_context.Objects = objects.Where(x =&gt; x.Files.Any(f =&gt; IsXpsAlike(f.Name))).ToList();&#xD;&#xA;&#x9;&#x9;DataSource = _context;&#xD;&#xA;&#x9;});&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;private RObject GetRealObject(RObject shortCutObj)&#xD;&#xA;{&#xD;&#xA;&#x9;object idValue;&#xD;&#xA;&#x9;Guid realObjId;&#xD;&#xA;&#x9;shortCutObj.Attributes.TryGetValue(SystemAttributes.SHORTCUT_OBJECT_ID, out idValue);&#xD;&#xA;&#x9;if (Guid.TryParse(idValue.ToString(), out realObjId))&#xD;&#xA;      {&#xD;&#xA;&#x9;&#x9;var realObj = _context.GetObject(realObjId);&#xD;&#xA;&#x9;&#x9;if (!realObj.IsInRecycleBin)&#xD;&#xA;&#x9;&#x9;&#x9;return realObj;&#xD;&#xA;      }&#xD;&#xA;&#x9;throw new ReportException(&quot;Не удалось получить проект, на который ссылается ярлык. Возможно проект находится в корзине.&quot;);&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;private void PageFormat_GetValue(object sender, DevExpress.XtraReports.UI.GetValueEventArgs e) &#xD;&#xA;{&#xD;&#xA;&#x9;LongRunning.Start(this, () =&gt; {&#xD;&#xA;&#x9;&#x9;var obj = (RObject)e.Row;&#xD;&#xA;&#x9;&#x9;var paperSize = GetPaperSize(obj);&#xD;&#xA;&#x9;&#x9;e.Value = paperSize;&#x9;&#x9;&#xD;&#xA;&#x9;});&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;private string GetPaperSize(RObject obj)&#xD;&#xA;{&#xD;&#xA;&#x9;var file = obj.Files.First(f =&gt; IsXpsAlike(f.Name));&#xD;&#xA;&#x9;string paperSize;&#xD;&#xA;&#x9;if(!paperSizeCache.TryGetValue(file.Id, out paperSize))&#xD;&#xA;&#x9;{&#xD;&#xA;&#x9;&#x9;using(var stream = _context.OpenFile(file))&#xD;&#xA;&#x9;&#x9;{&#xD;&#xA;&#x9;&#x9;&#x9;try&#xD;&#xA;&#x9;&#x9;&#x9;{&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;var sizes = PaperSizeHelper.GetPaperSizes(stream);&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;paperSize = string.Join(&quot;,&quot;, sizes.Select(x =&gt; x.Name));&#xD;&#xA;&#x9;&#x9;&#x9;}&#xD;&#xA;&#x9;&#x9;&#x9;catch&#xD;&#xA;&#x9;&#x9;&#x9;{&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;paperSize = &quot;Ошибка при чтении xps файла&quot;;&#xD;&#xA;&#x9;&#x9;&#x9;}&#xD;&#xA;&#x9;&#x9;}&#xD;&#xA;&#x9;&#x9;paperSizeCache[file.Id] = paperSize;&#xD;&#xA;&#x9;}&#xD;&#xA;&#x9;return paperSize;&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;static bool IsXpsAlike(string filePath)&#xD;&#xA;{&#xD;&#xA;      var extension = Path.GetExtension(filePath);&#xD;&#xA;      return !string.IsNullOrEmpty(extension) &amp;&amp; Regex.IsMatch(extension, @&quot;\.xps$|\.dwfx$&quot;, RegexOptions.IgnoreCase);&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;class PaperSize&#xD;&#xA;{&#xD;&#xA;&#x9;public string Name { get; private set; }&#xD;&#xA;&#x9;public int Width { get; private set; }&#xD;&#xA;&#x9;public int Height { get; private set; }&#xD;&#xA;&#xD;&#xA;&#x9;public PaperSize(string name, int width, int height)&#xD;&#xA;&#x9;{&#xD;&#xA;&#x9;&#x9;Name = name;&#xD;&#xA;&#x9;&#x9;Width = width;&#xD;&#xA;&#x9;&#x9;Height = height;&#xD;&#xA;&#x9;}&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;class PaperSizeHelper&#xD;&#xA;{&#xD;&#xA;&#x9;public const string FIXED_PAGE_CONTENT_TYPE = &quot;application/vnd.ms-package.xps-fixedpage+xml&quot;;&#xD;&#xA;&#xD;&#xA;&#x9;private static readonly IList&lt;PaperSize&gt; StandartSizes = new List&lt;PaperSize&gt;();&#xD;&#xA;&#xD;&#xA;&#x9;static PaperSizeHelper()&#xD;&#xA;&#x9;{&#xD;&#xA;&#x9;&#x9;StandartSizes.Add(new PaperSize(&quot;C1&quot;, ToDpi(&quot;648&quot;), ToDpi(&quot;917&quot;)));&#xD;&#xA;&#x9;&#x9;StandartSizes.Add(new PaperSize(&quot;C2&quot;, ToDpi(&quot;458&quot;), ToDpi(&quot;648&quot;)));&#xD;&#xA;&#x9;&#x9;StandartSizes.Add(new PaperSize(&quot;C3&quot;, ToDpi(&quot;324&quot;), ToDpi(&quot;458&quot;)));&#xD;&#xA;&#x9;&#x9;StandartSizes.Add(new PaperSize(&quot;C4&quot;, ToDpi(&quot;229&quot;), ToDpi(&quot;324&quot;)));&#xD;&#xA;&#xD;&#xA;&#x9;&#x9;StandartSizes.Add(new PaperSize(&quot;B1&quot;, ToDpi(&quot;707&quot;), ToDpi(&quot;1000&quot;)));&#xD;&#xA;&#x9;&#x9;StandartSizes.Add(new PaperSize(&quot;B2&quot;, ToDpi(&quot;500&quot;), ToDpi(&quot;707&quot;)));&#xD;&#xA;&#x9;&#x9;StandartSizes.Add(new PaperSize(&quot;B3&quot;, ToDpi(&quot;353&quot;), ToDpi(&quot;500&quot;)));&#xD;&#xA;&#x9;&#x9;StandartSizes.Add(new PaperSize(&quot;B4&quot;, ToDpi(&quot;250&quot;), ToDpi(&quot;353&quot;)));&#xD;&#xA;&#xD;&#xA;&#x9;&#x9;StandartSizes.Add(new PaperSize(&quot;A2x4&quot;, ToDpi(&quot;594&quot;), ToDpi(&quot;1682&quot;)));&#xD;&#xA;&#x9;&#x9;StandartSizes.Add(new PaperSize(&quot;A2x3&quot;, ToDpi(&quot;594&quot;), ToDpi(&quot;1261&quot;)));&#xD;&#xA;&#xD;&#xA;&#x9;&#x9;StandartSizes.Add(new PaperSize(&quot;A3x5&quot;, ToDpi(&quot;420&quot;), ToDpi(&quot;1487&quot;)));&#xD;&#xA;&#x9;&#x9;StandartSizes.Add(new PaperSize(&quot;A3x4&quot;, ToDpi(&quot;420&quot;), ToDpi(&quot;1189&quot;)));&#xD;&#xA;&#x9;&#x9;StandartSizes.Add(new PaperSize(&quot;A3x3&quot;, ToDpi(&quot;420&quot;), ToDpi(&quot;892&quot;)));&#xD;&#xA;&#xD;&#xA;&#x9;&#x9;StandartSizes.Add(new PaperSize(&quot;A4x5&quot;, ToDpi(&quot;297&quot;), ToDpi(&quot;1051&quot;)));&#xD;&#xA;&#x9;&#x9;StandartSizes.Add(new PaperSize(&quot;A4x4&quot;, ToDpi(&quot;297&quot;), ToDpi(&quot;841&quot;)));&#xD;&#xA;&#x9;&#x9;StandartSizes.Add(new PaperSize(&quot;A4x3&quot;, ToDpi(&quot;297&quot;), ToDpi(&quot;631&quot;)));&#xD;&#xA;&#xD;&#xA;&#x9;&#x9;StandartSizes.Add(new PaperSize(&quot;A0&quot;, ToDpi(&quot;841&quot;), ToDpi(&quot;1189&quot;)));&#xD;&#xA;&#x9;&#x9;StandartSizes.Add(new PaperSize(&quot;A1&quot;, ToDpi(&quot;594&quot;), ToDpi(&quot;841&quot;)));&#xD;&#xA;&#x9;&#x9;StandartSizes.Add(new PaperSize(&quot;A2&quot;, ToDpi(&quot;420&quot;), ToDpi(&quot;594&quot;)));&#xD;&#xA;&#x9;&#x9;StandartSizes.Add(new PaperSize(&quot;A3&quot;, ToDpi(&quot;297&quot;), ToDpi(&quot;420&quot;)));&#xD;&#xA;&#x9;&#x9;StandartSizes.Add(new PaperSize(&quot;A4&quot;, ToDpi(&quot;210&quot;), ToDpi(&quot;297&quot;)));&#xD;&#xA;&#x9;&#x9;StandartSizes.Add(new PaperSize(&quot;A5&quot;, ToDpi(&quot;148&quot;), ToDpi(&quot;210&quot;)));&#xD;&#xA;&#x9;}&#xD;&#xA;&#xD;&#xA;&#x9;public static int GetPageCount(Stream docStream)&#xD;&#xA;&#x9;{&#xD;&#xA;&#x9;&#x9;using (var sourcePackage = Package.Open(docStream))&#xD;&#xA;&#x9;&#x9;{&#xD;&#xA;&#x9;&#x9;&#x9;var sourcePageParts = sourcePackage.GetParts().Where(sourcePart =&gt; sourcePart.ContentType == FIXED_PAGE_CONTENT_TYPE);&#xD;&#xA;&#x9;&#x9;&#x9;return sourcePageParts.Count();&#xD;&#xA;&#x9;&#x9;}&#xD;&#xA;&#x9;}&#xD;&#xA;&#xD;&#xA;&#x9;public static IList&lt;PaperSize&gt; GetPaperSizes(Stream docStream)&#xD;&#xA;&#x9;{&#xD;&#xA;&#x9;&#x9;if (docStream == Stream.Null)&#xD;&#xA;&#x9;&#x9;&#x9;return null;&#xD;&#xA;&#x9;&#x9;var paperSizes = new List&lt;PaperSize&gt;();&#xD;&#xA;&#xD;&#xA;&#x9;&#x9;using (var sourcePackage = Package.Open(docStream))&#xD;&#xA;&#x9;&#x9;{&#xD;&#xA;&#x9;&#x9;&#x9;var pages = sourcePackage.GetParts().Where(sourcePart =&gt; sourcePart.ContentType == FIXED_PAGE_CONTENT_TYPE);&#xD;&#xA;&#x9;&#x9;&#x9;foreach (var page in pages)&#xD;&#xA;&#x9;&#x9;&#x9;{&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;var fixedPage = XElement.Load(page.GetStream());&#xD;&#xA;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;var widthAttr = fixedPage.Attribute(&quot;Width&quot;);&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;var pageWidth = widthAttr != null ? (int)double.Parse(widthAttr.Value, CultureInfo.InvariantCulture) : 0;&#xD;&#xA;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;var heightAttr = fixedPage.Attribute(&quot;Height&quot;);&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;var pageHeight = heightAttr != null ? (int)double.Parse(heightAttr.Value, CultureInfo.InvariantCulture) : 0;&#xD;&#xA;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;var papersize = GetClosestPaperSize(pageWidth, pageHeight);&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;if (paperSizes.FirstOrDefault(p =&gt; p.Height == papersize.Height &amp;&amp; p.Width == papersize.Width) == null)&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;paperSizes.Add(papersize);&#xD;&#xA;&#x9;&#x9;&#x9;}&#xD;&#xA;&#x9;&#x9;}&#xD;&#xA;&#x9;&#x9;return paperSizes;&#xD;&#xA;&#x9;}&#xD;&#xA;&#xD;&#xA;&#x9;private static PaperSize GetClosestPaperSize(int pageWidth, int pageHeight)&#xD;&#xA;&#x9;{&#xD;&#xA;&#x9;&#x9;var paperSize = new PaperSize(string.Format(&quot;{0}x{1}&quot;, FromDpiToMm(pageWidth), FromDpiToMm(pageHeight)), pageWidth, pageHeight);&#xD;&#xA;&#x9;&#x9;var matchedSize = StandartSizes.FirstOrDefault(s =&gt; s.Width == pageWidth &amp;&amp; s.Height == pageHeight);&#xD;&#xA;&#x9;&#x9;if (matchedSize != null)&#xD;&#xA;&#x9;&#x9;&#x9;paperSize = matchedSize;&#xD;&#xA;&#xD;&#xA;&#x9;&#x9;double currentIsFitted = -1;&#xD;&#xA;&#xD;&#xA;&#x9;&#x9;//Допуск - один процент от среднего размеров&#xD;&#xA;&#x9;&#x9;double tolerance = ((pageWidth + pageHeight) / 2.0) / 100;&#xD;&#xA;&#xD;&#xA;&#x9;&#x9;foreach (var standartSize in StandartSizes)&#xD;&#xA;&#x9;&#x9;{&#xD;&#xA;&#x9;&#x9;&#x9;var isFitted = GetDeltaFitted(new Size(pageWidth, pageHeight), new Size(standartSize.Width, standartSize.Height), 1);&#xD;&#xA;&#x9;&#x9;&#x9;if (isFitted &gt;= 0 &amp;&amp; isFitted &lt; tolerance &amp;&amp; (isFitted &lt; currentIsFitted || currentIsFitted &lt; 0))&#xD;&#xA;&#x9;&#x9;&#x9;{&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;currentIsFitted = isFitted;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;paperSize = standartSize;&#xD;&#xA;&#x9;&#x9;&#x9;}&#xD;&#xA;&#x9;&#x9;}&#xD;&#xA;&#x9;&#x9;return paperSize;&#xD;&#xA;&#x9;}&#xD;&#xA;&#xD;&#xA;&#x9;private static double GetDeltaFitted(Size sizeFixedPage, Size sizeContainer, int percentageError)&#xD;&#xA;&#x9;{&#xD;&#xA;&#x9;&#x9;var width = Math.Min(sizeFixedPage.Width, sizeFixedPage.Height);&#xD;&#xA;&#x9;&#x9;var height = Math.Max(sizeFixedPage.Width, sizeFixedPage.Height);&#xD;&#xA;&#xD;&#xA;&#x9;&#x9;var widthContainer = Math.Min(sizeContainer.Width, sizeContainer.Height);&#xD;&#xA;&#x9;&#x9;var heightContainer = Math.Max(sizeContainer.Width, sizeContainer.Height);&#xD;&#xA;&#xD;&#xA;&#x9;&#x9;// Допустимая погрешность в размере, чтоб считать, что страница помещается&#xD;&#xA;&#x9;&#x9;double delta = (width * percentageError) / 100;&#xD;&#xA;&#x9;&#x9;if ((widthContainer + delta) &gt;= width &amp;&amp; heightContainer + delta &gt;= height)&#xD;&#xA;&#x9;&#x9;&#x9;return Math.Sqrt(Math.Abs(widthContainer + delta - width) * Math.Abs(heightContainer + delta - height));&#xD;&#xA;&#x9;&#x9;return -1;&#xD;&#xA;&#x9;}&#xD;&#xA;&#xD;&#xA;&#x9;private static string FromDpiToMm(double value)&#xD;&#xA;&#x9;{&#xD;&#xA;&#x9;&#x9;string millimetre;&#xD;&#xA;&#x9;&#x9;try&#xD;&#xA;&#x9;&#x9;{&#xD;&#xA;&#x9;&#x9;&#x9;millimetre = Math.Round(value / 96 * 25.4).ToString(&quot;f0&quot;);&#xD;&#xA;&#x9;&#x9;}&#xD;&#xA;&#x9;&#x9;catch (Exception)&#xD;&#xA;&#x9;&#x9;{&#xD;&#xA;&#x9;&#x9;&#x9;return &quot;0&quot;;&#xD;&#xA;&#x9;&#x9;}&#xD;&#xA;&#xD;&#xA;&#x9;&#x9;return millimetre;&#xD;&#xA;&#x9;}&#xD;&#xA;&#xD;&#xA;&#x9;private static int ToDpi(string value)&#xD;&#xA;&#x9;{&#xD;&#xA;&#x9;&#x9;int mm;&#xD;&#xA;&#x9;&#x9;int.TryParse(value, out mm);&#xD;&#xA;&#x9;&#x9;return (int)((mm / 25.4) * 96);&#xD;&#xA;&#x9;}&#xD;&#xA;}" Margins="100, 100, 86, 100" PaperKind="A4" PageWidth="827" PageHeight="1169" Version="20.1" DataSource="#Ref-0">
