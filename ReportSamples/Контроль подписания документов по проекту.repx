<?xml version="1.0" encoding="utf-8"?>
<XtraReportsLayoutSerializer SerializerVersion="20.1.8.0" Ref="1" ControlType="Ascon.Pilot.Pilot.Reports.PilotReport, Ascon.Pilot.Pilot, Version=0.0.0.0, Culture=neutral, PublicKeyToken=null" Name="PilotReport" ScriptsSource="using Ascon.Pilot.ProjectionsRepository;&#xD;&#xA;using Ascon.Pilot.ClientCore.Search;&#xD;&#xA;using Ascon.Pilot.DataClasses;&#xD;&#xA;using System.Linq;&#xD;&#xA;using System.IO.Packaging;&#xD;&#xA;using System.IO;&#xD;&#xA;using System.Text.RegularExpressions;&#xD;&#xA;using System.Security.Cryptography.X509Certificates;&#xD;&#xA;using System.Collections.Generic;&#xD;&#xA;using Ascon.Pilot.Core;&#xD;&#xA;using Ascon.Pilot.Client.Search;&#xD;&#xA;using Ascon.Pilot.Common.Search;&#xD;&#xA;using Ascon.Pilot.Pilot.Reports;&#xD;&#xA;using Ascon.Pilot.XpsRender.Signatures;&#xD;&#xA;using DevExpress.XtraReports.Parameters;&#xD;&#xA;&#xD;&#xA;const string NO_SIGNS = &quot;Нет запросов на подпись&quot;;&#x9;&#xD;&#xA;const string SIGNED = &quot;Подписаны&quot;;&#xD;&#xA;const string NOT_SIGNED = &quot;Не подписаны&quot;;&#xD;&#xA;const string AWAITING_FOR_SIGN = &quot;Ожидают подписи&quot;;&#xD;&#xA;&#xD;&#xA;ReportContext _context = new ReportContext();&#xD;&#xA;&#xD;&#xA;private void PilotReport_DataSourceDemanded(object sender, System.EventArgs e) &#xD;&#xA;{&#xD;&#xA;&#x9;LongRunning.Start(this, () =&gt; {&#xD;&#xA;&#x9;&#x9;var project = Parameters[&quot;Project&quot;].Value as RObject;&#x9;&#xD;&#xA;&#x9;&#x9;if (project == null)&#xD;&#xA;&#x9;&#x9;&#x9;throw new ReportException(&quot;Проект не выбран&quot;);&#xD;&#xA;&#xD;&#xA;&#x9;&#x9;if (project.Type.Name == SystemTypes.SHORTCUT)&#xD;&#xA;&#x9;&#x9;{&#xD;&#xA;&#x9;&#x9;&#x9;project = GetRealObject(project);&#xD;&#xA;&#x9;&#x9;&#x9;Parameters[&quot;Project&quot;].Value = project;&#xD;&#xA;&#x9;&#x9;}&#xD;&#xA;&#xD;&#xA;&#x9;&#x9;var documentTypes = _context.GetTypes().Where(x =&gt; x.HasFiles).Select(x =&gt; x.Id).ToArray();&#xD;&#xA;&#x9;&#x9;var objectsBuilder = QueryBuilder.CreateObjectQueryBuilder();&#x9;&#xD;&#xA;&#x9;&#x9;objectsBuilder.Must(ObjectFields.TypeId.BeAnyOf(documentTypes));&#xD;&#xA;&#x9;&#x9;_context.Objects = _context.GetObjects(objectsBuilder, project.Id).Where(HasSignatures).ToList(); &#xD;&#xA;&#x9;&#xD;&#xA;&#x9;&#x9;DataSource = _context;&#xD;&#xA;&#x9;});&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;private RObject GetRealObject(RObject shortCutObj)&#xD;&#xA;{&#xD;&#xA;&#x9;object idValue;&#xD;&#xA;&#x9;Guid realObjId;&#xD;&#xA;&#x9;shortCutObj.Attributes.TryGetValue(SystemAttributes.SHORTCUT_OBJECT_ID, out idValue);&#xD;&#xA;&#x9;if (Guid.TryParse(idValue.ToString(), out realObjId))&#xD;&#xA;      {&#xD;&#xA;&#x9;&#x9;var realObj = _context.GetObject(realObjId);&#xD;&#xA;&#x9;&#x9;if (!realObj.IsInRecycleBin)&#xD;&#xA;&#x9;&#x9;&#x9;return realObj;&#xD;&#xA;      }&#xD;&#xA;&#x9;throw new ReportException(&quot;Не удалось получить проект, на который ссылается ярлык. Возможно проект находится в корзине.&quot;);&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;private void DetailReport1_BeforePrint(object sender, System.Drawing.Printing.PrintEventArgs e) &#xD;&#xA;{&#xD;&#xA;&#x9;var signatures = GetSignatures((RObject)DetailReport.GetCurrentRow());&#xD;&#xA;&#x9;if(!signatures.Any())&#xD;&#xA;&#x9;{&#xD;&#xA;&#x9;&#x9;e.Cancel = true;&#xD;&#xA;&#x9;&#x9;return;&#xD;&#xA;&#x9;}&#xD;&#xA;&#x9;DetailReport1.DataSource = signatures;&#xD;&#xA;&#x9;lbFio.DataBindings.Add(&quot;Text&quot;, null, &quot;Person&quot;);&#xD;&#xA;&#x9;lbRole.DataBindings.Add(&quot;Text&quot;, null, &quot;Role&quot;);&#xD;&#xA;&#x9;lbSignDate.DataBindings.Add(&quot;Text&quot;, null, &quot;Date&quot;);&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;private bool HasSignatures(RObject obj)&#xD;&#xA;{&#xD;&#xA;&#x9;return GetSignatures(obj).Any();&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;private void SignsCount_GetValue(object sender, DevExpress.XtraReports.UI.GetValueEventArgs e) &#xD;&#xA;{&#xD;&#xA;&#x9;e.Value = GetSignatures((RObject)e.Row).Count(x =&gt; x.Date != null);&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;private void NotSignedCount_GetValue(object sender, DevExpress.XtraReports.UI.GetValueEventArgs e) &#xD;&#xA;{&#xD;&#xA;&#x9;e.Value = GetSignatures((RObject)e.Row).Count(x =&gt; x.Date == null);&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;private void SignatureStatus_GetValue(object sender, DevExpress.XtraReports.UI.GetValueEventArgs e) &#xD;&#xA;{&#xD;&#xA;&#x9;var signatures = GetSignatures((RObject)e.Row);&#xD;&#xA;&#x9;if(!signatures.Any())&#xD;&#xA;&#x9;&#x9;e.Value = NO_SIGNS;&#xD;&#xA;&#x9;else if(signatures.All(x =&gt; x.Date == null))&#xD;&#xA;&#x9;&#x9;e.Value = NOT_SIGNED;&#xD;&#xA;&#x9;else if(signatures.All(x =&gt; x.Date != null))&#xD;&#xA;&#x9;&#x9;e.Value = SIGNED;&#xD;&#xA;&#x9;else&#xD;&#xA;&#x9;&#x9;e.Value = AWAITING_FOR_SIGN;&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;private IEnumerable&lt;Signature&gt; GetSignatures(RObject obj)&#xD;&#xA;{&#xD;&#xA;&#x9;if(obj == null)&#xD;&#xA;&#x9;&#x9;return new Signature[0];&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#xD;&#xA;&#x9;var file = obj.Files.FirstOrDefault(x =&gt; x.Name.EndsWith(&quot;.xps&quot;) || x.Name.EndsWith(&quot;.pdf&quot;));&#x9;&#xD;&#xA;&#x9;if (file == null)&#xD;&#xA;&#x9;&#x9;return new Signature[0];&#xD;&#xA;&#x9;&#xD;&#xA;&#x9;var signaturesWithoutRequest = new List&lt;Signature&gt;();&#xD;&#xA;&#x9;if (file.Name.EndsWith(&quot;.xps&quot;))&#xD;&#xA;&#x9;{&#xD;&#xA;&#x9;&#x9;var signatureFiles = obj.Files.Where(x =&gt; x.Name.Contains(&quot;PilotDigitalSignature&quot;)).ToList();&#xD;&#xA;&#x9;&#x9;using(var stream = _context.OpenFile(file))&#xD;&#xA;&#x9;&#x9;{&#xD;&#xA;&#x9;&#x9;&#x9;var copy = new MemoryStream();&#xD;&#xA;&#x9;&#x9;&#x9;stream.CopyTo(copy);&#xD;&#xA;&#x9;&#x9;&#x9;using(copy)&#xD;&#xA;&#x9;&#x9;&#x9;{&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;using (var p = Package.Open(copy , FileMode.Open, FileAccess.ReadWrite))&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;{&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;var digitalSignatureList = new List&lt;DigitalSignature&gt;();&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;foreach(var signatureFile in signatureFiles)&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;{&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;using(var signatureStream = _context.OpenFile(signatureFile))&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;{&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;var digitalSignature = DigitalSignatureSerializer.Deserialize(signatureStream);&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;if (!file.Signatures.Any(f =&gt; f.Id == digitalSignature.SpotId))&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;digitalSignatureList.Add(digitalSignature);&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;}&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;}&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;SignatureUtils.SignPackage(p, digitalSignatureList);&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;var packageSignatureManager = new PackageDigitalSignatureManager(p);&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;var packageDigitalSignatureList = packageSignatureManager.Signatures;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;foreach(var s in packageDigitalSignatureList)&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;{&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;var certificate2 = new X509Certificate2(s.Signer);&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;var position = &quot;&quot;;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;try&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;{&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;position = Regex.Match(certificate2.Subject, @&quot;(?&lt;=\b, T=\b)\w+(?=\b, \b)&quot;).Groups[0].Value;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;}&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;catch (Exception) { }&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;var date = s.SigningTime.ToLocalTime().ToString(&quot;dd.MM.yyyy&quot;);&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;var signerName = certificate2.GetNameInfo(X509NameType.DnsName, false);&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;if (!signerName.Contains(&quot;)&quot;) &amp;&amp; !signerName .Contains(&quot;(&quot;) &amp;&amp; !string.IsNullOrEmpty(position))&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;signerName = String.Format(&quot;{0} ({1})&quot;, certificate2.GetNameInfo(X509NameType.DnsName, false), position);&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;signaturesWithoutRequest.Add(new Signature(signerName , &quot;&quot;, date));&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;}&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;}&#xD;&#xA;&#x9;&#x9;&#x9;}&#xD;&#xA;&#x9;&#x9;}&#xD;&#xA;&#x9;}&#xD;&#xA;&#x9;var signaturesResult = file.Signatures.Select(signature =&gt; &#xD;&#xA;&#x9;{&#xD;&#xA;&#x9;&#x9;var date = string.IsNullOrEmpty(signature.Sign) ? (string)null : obj.Files.First(x =&gt; x.Id == new Guid(signature.Sign)).Created.ToString(&quot;dd.MM.yyyy&quot;);&#xD;&#xA;&#x9;&#x9;return new Signature(signature.RequestedSigner, signature.Role, date);&#xD;&#xA;&#x9;}).ToList();&#xD;&#xA;&#x9;signaturesResult.AddRange(signaturesWithoutRequest);&#xD;&#xA;&#x9;return signaturesResult;&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;public class Signature &#xD;&#xA;{&#xD;&#xA;&#x9;public Signature(string person, string role, string date) &#xD;&#xA;&#x9;{&#xD;&#xA;&#x9;&#x9;Person = person;&#xD;&#xA;&#x9;&#x9;Role = role;&#xD;&#xA;&#x9;&#x9;Date = date;&#xD;&#xA;&#x9;}&#xD;&#xA;&#x9;public string Person {get; private set;}&#xD;&#xA;&#x9;public string Role {get; private set;}&#xD;&#xA;&#x9;public string Date {get; private set;}&#xD;&#xA;}&#xD;&#xA;" Landscape="true" Margins="100, 100, 45, 49" PaperKind="A4" PageWidth="1169" PageHeight="827" Version="20.1" DataSource="#Ref-0">
