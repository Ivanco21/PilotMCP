<?xml version="1.0" encoding="utf-8"?>
<XtraReportsLayoutSerializer SerializerVersion="20.1.8.0" Ref="1" ControlType="DevExpress.XtraReports.UI.XtraReport, DevExpress.XtraReports.v20.1, Version=20.1.8.0, Culture=neutral, PublicKeyToken=b88d1754d700e49a" Name="TasksByOrganisationReport" ScriptsSource="using Ascon.Pilot.ProjectionsRepository;&#xD;&#xA;using Ascon.Pilot.ClientCore.Search;&#xD;&#xA;using Ascon.Pilot.DataClasses;&#xD;&#xA;using System.Collections.Generic;&#xD;&#xA;using System.Linq;&#xD;&#xA;using Ascon.Pilot.Client.Search;&#xD;&#xA;using Ascon.Pilot.Common.Search;&#xD;&#xA;using Ascon.Pilot.Pilot.Reports;&#xD;&#xA;using DevExpress.XtraReports.Parameters;&#xD;&#xA;&#xD;&#xA;ReportContext context = new ReportContext();&#xD;&#xA;Dictionary&lt;int, ROrganisationUnit&gt; departmentsCache = new Dictionary&lt;int, ROrganisationUnit&gt;();&#xD;&#xA;&#xD;&#xA;private void PilotReport_ParametersRequestBeforeShow(object sender, DevExpress.XtraReports.Parameters.ParametersRequestEventArgs e) &#xD;&#xA;{&#xD;&#xA;&#x9;var root = context.GetOrganisationUnit(0);&#xD;&#xA;&#x9;StaticListLookUpSettings lookUpSettings = new StaticListLookUpSettings();&#xD;&#xA;&#x9;foreach(var organisation in root.Children)&#xD;&#xA;&#x9;{&#xD;&#xA;&#x9;&#x9;lookUpSettings.LookUpValues.Add(new LookUpValue(organisation.Id, organisation.Title));&#xD;&#xA;&#x9;}&#xD;&#xA;&#x9;Parameters[&quot;Organisation&quot;].LookUpSettings = lookUpSettings;&#xD;&#xA;&#x9;Parameters[&quot;Organisation&quot;].Value = lookUpSettings.LookUpValues.Select(x =&gt; x.Value).FirstOrDefault();&#xD;&#xA;&#xD;&#xA;&#x9;Parameters[&quot;From&quot;].Value = DateTime.Today.AddDays(-14);&#xD;&#xA;&#x9;Parameters[&quot;To&quot;].Value = DateTime.Today.AddDays(1).AddSeconds(-1);&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;private void PilotReport_DataSourceDemanded(object sender, System.EventArgs e) &#xD;&#xA;{&#xD;&#xA;&#x9;LongRunning.Start(this, () =&gt; {&#xD;&#xA;&#x9;&#x9;&#xD;&#xA;&#x9;&#x9;var organisationId = (int)Parameters[&quot;Organisation&quot;].Value;&#xD;&#xA;&#x9;&#x9;var organisation = context.GetOrganisationUnit(organisationId);&#xD;&#xA;&#x9;&#x9;FillDepartmentsCache(organisation);&#xD;&#xA;&#xD;&#xA;&#x9;&#x9;var ids = GetPositions(organisation);&#xD;&#xA;&#x9;&#x9;if(!ids.Any())&#xD;&#xA;&#x9;&#x9;&#x9;throw new Exception(&quot;В выбранном подразделении нет ни одной должности&quot;);&#xD;&#xA;&#xD;&#xA;&#x9;&#x9;var from = (DateTime)Parameters[&quot;From&quot;].Value;&#xD;&#xA;&#x9;&#x9;var to = (DateTime)Parameters[&quot;To&quot;].Value;&#xD;&#xA;&#x9;&#xD;&#xA;&#x9;&#x9;var builder = QueryBuilder.CreateEmptyQueryBuilder();&#xD;&#xA;&#x9;&#x9;builder.Must(AttributeFields.DateTime(&quot;dateOfAssignment&quot;).BeInRange(from.ToUniversalTime(), to.ToUniversalTime()));&#xD;&#xA;&#x9;&#x9;builder.Must(AttributeFields.OrgUnit(&quot;executor&quot;).BeAnyOf(ids.ToArray()));&#xD;&#xA;&#x9;&#x9;builder.MustNot(AttributeFields.State(&quot;state&quot;).Be(SystemStates.TASK_REVOKED_STATE_ID));&#xD;&#xA;&#xD;&#xA;&#x9;&#x9;context.Objects = context.GetObjects(builder);&#xD;&#xA;&#x9;&#x9;&#xD;&#xA;&#x9;&#x9;DataSource = context;&#x9;&#xD;&#xA;&#x9;});&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;private void Initiator_GetValue(object sender, DevExpress.XtraReports.UI.GetValueEventArgs e) {&#xD;&#xA;&#x9;e.Value = GetOrgUnitAttributeValue(e, &quot;initiator&quot;);&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;private void Executor_GetValue(object sender, DevExpress.XtraReports.UI.GetValueEventArgs e) {&#xD;&#xA;&#x9;e.Value = GetOrgUnitAttributeValue(e, &quot;executor&quot;);&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;private void IsCompleted_GetValue(object sender, DevExpress.XtraReports.UI.GetValueEventArgs e) {&#xD;&#xA;&#x9;var obj = (RObject)e.Row;&#xD;&#xA;&#x9;e.Value = obj.Attributes.ContainsKey(&quot;dateOfCompletion&quot;);&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;private void ExpiredDays_GetValue(object sender, DevExpress.XtraReports.UI.GetValueEventArgs e) {&#xD;&#xA;&#x9;var deadline = GetAttributeValue&lt;DateTime?&gt;(e, &quot;deadlineDate&quot;) ?? DateTime.MaxValue;&#xD;&#xA;&#x9;if(deadline == DateTime.MaxValue){&#xD;&#xA;&#x9;&#x9;e.Value = 0;&#xD;&#xA;&#x9;&#x9;return;&#xD;&#xA;&#x9;}&#xD;&#xA;&#x9;var compareToDate = GetAttributeValue&lt;DateTime?&gt;(e, &quot;dateOfCompletion&quot;) ?? DateTime.UtcNow;&#xD;&#xA;&#x9;if(compareToDate &lt; deadline){&#xD;&#xA;&#x9;&#x9;e.Value = 0;&#xD;&#xA;&#x9;&#x9;return;&#xD;&#xA;&#x9;}&#xD;&#xA;&#x9;var days = (compareToDate - deadline).Days;&#xD;&#xA;&#x9;if(days == 0)&#xD;&#xA;&#x9;&#x9;days = 1;&#xD;&#xA;&#x9;e.Value = days;&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;private string GetOrgUnitAttributeValue(GetValueEventArgs e, string attributeName)&#xD;&#xA;{&#xD;&#xA;&#x9;var ids = GetAttributeValue&lt;int[]&gt;(e, attributeName);&#xD;&#xA;&#x9;var orgUnits = ids != null ? ids.Select(context.GetOrganisationUnit) : null;&#xD;&#xA;&#x9;return orgUnits != null ? string.Join(&quot;, &quot;, orgUnits.Select(x =&gt; x.Person != null ? x.Person.DisplayName : x.Title + &quot;: пользователь не назначен&quot;)) : &quot;&lt;нет данных&gt;&quot;;&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;private T GetAttributeValue&lt;T&gt;(GetValueEventArgs e, string attributeName)&#xD;&#xA;{&#xD;&#xA;&#x9;var obj = (RObject)e.Row;&#xD;&#xA;&#x9;object value;&#xD;&#xA;&#x9;if(!obj.Attributes.TryGetValue(attributeName, out value))&#xD;&#xA;&#x9;&#x9;return default(T);&#xD;&#xA;&#x9;return (T)value;&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;private IEnumerable&lt;int&gt; GetPositions(ROrganisationUnit unit)&#xD;&#xA;{&#xD;&#xA;&#x9;return unit.IsPosition ? &#xD;&#xA;&#x9;&#x9;new[] { unit.Id } : &#xD;&#xA;&#x9;&#x9;unit.Children.SelectMany(x =&gt; GetPositions(x));&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;private void FillDepartmentsCache(ROrganisationUnit organisation)&#xD;&#xA;{&#xD;&#xA;&#x9;departmentsCache.Clear();&#xD;&#xA;&#x9;foreach(var department in organisation.Children)&#xD;&#xA;&#x9;{&#xD;&#xA;&#x9;&#x9;FillDepartmentsCacheRecursive(department, department);&#xD;&#xA;&#x9;}&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;private void FillDepartmentsCacheRecursive(ROrganisationUnit unit, ROrganisationUnit department)&#xD;&#xA;{&#xD;&#xA;&#x9;departmentsCache[unit.Id] = department;&#xD;&#xA;&#x9;foreach(var childUnit in unit.Children)&#xD;&#xA;&#x9;{&#xD;&#xA;&#x9;&#x9;FillDepartmentsCacheRecursive(childUnit, department);&#xD;&#xA;&#x9;}&#x9;&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;private void Department_GetValue(object sender, DevExpress.XtraReports.UI.GetValueEventArgs e) {&#xD;&#xA;&#x9;var task = (RObject)e.Row;&#xD;&#xA;&#x9;var executor = GetAttributeValue&lt;int[]&gt;(e, &quot;executor&quot;).First();&#xD;&#xA;&#x9;var department = departmentsCache[executor];&#xD;&#xA;&#x9;e.Value = department.Title;&#xD;&#xA;}" Bookmark="TasksByOrganisationReport" Landscape="true" Margins="80, 79, 50, 60" PaperKind="A4" PageWidth="1169" PageHeight="827" Version="20.1" DataSource="#Ref-0" Font="Segoe UI, 9.75pt, charSet=204">
