      <Controls>
        <Item1 Ref="15" ControlType="XRLabel" Name="FooterInfoLabel" Multiline="true" Text="&lt;информация о построении отчёта&gt;" SizeF="676.999939,19.666666" LocationFloat="0,10" Font="Segoe UI, 7.75pt, charSet=204" Padding="2,2,0,0,100">
