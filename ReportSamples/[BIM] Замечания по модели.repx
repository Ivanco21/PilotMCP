<?xml version="1.0" encoding="utf-8"?>
<XtraReportsLayoutSerializer SourceReportTypesNames="bim_coordinationModel; bim_modelPart" SerializerVersion="20.1.8.0" Ref="1" ControlType="Ascon.Pilot.Pilot.Reports.PilotReport, Ascon.Pilot.Pilot, Version=0.0.0.0, Culture=neutral, PublicKeyToken=null" Name="PilotReport" ScriptsSource="using Ascon.Pilot.Common.Search;&#xD;&#xA;using Ascon.Pilot.ClientCore.Search;&#xD;&#xA;using Ascon.Pilot.DataClasses;&#xD;&#xA;using System.Linq;&#xD;&#xA;using System.Collections.Generic;&#xD;&#xA;using Ascon.Pilot.ProjectionsRepository;&#xD;&#xA;using Ascon.Pilot.Theme.ColorScheme;&#xD;&#xA;using Ascon.Pilot.Pilot.Reports;&#xD;&#xA;using DevExpress.XtraReports.Parameters;&#xD;&#xA;using DevExpress.XtraPrinting.Drawing;&#xD;&#xA;using Ascon.Pilot.BimViewer.Reports;&#xD;&#xA;using Ascon.Pilot.BimUtils;&#xD;&#xA;using Ascon.Pilot.Client;&#xD;&#xA;using Ascon.Pilot.SDK;&#xD;&#xA;using Ascon.Pilot.PluginLoader.CrossDomainObjects;&#xD;&#xA;using System.Threading;&#xD;&#xA;using System.Threading.Tasks;&#xD;&#xA;using Ascon.Pilot.Bim.SDK.ModelStorage;&#xD;&#xA;using Ascon.Pilot.Bim.SDK;&#xD;&#xA;&#xD;&#xA;private readonly Guid DELETED_STATE_ID = Guid.Parse(&quot;6548faf7-cc0a-4640-8e05-cc23bacdca4f&quot;);&#xD;&#xA;&#xD;&#xA;private ReportContext Context = new ReportContext();&#xD;&#xA;private List&lt;INUserState&gt; UserStates = new List&lt;INUserState&gt;();&#xD;&#xA;&#xD;&#xA;private void PilotReport_DataSourceDemanded(object sender, System.EventArgs e)&#xD;&#xA;{&#xD;&#xA;&#x9;var modelLoadingParams = CoordinationModelLoadingParams.GetFromReportParams(Parameters);&#xD;&#xA;&#x9;var modelStorage = LoadModelStorage(modelLoadingParams);&#xD;&#xA;&#xD;&#xA;&#x9;FillReportHeaderAndFooter(modelStorage, modelLoadingParams);&#xD;&#xA;&#x9;FillReportDataSource(modelStorage, modelLoadingParams);&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;private void AnnotationTextLabel_BeforePrint(object sender, System.Drawing.Printing.PrintEventArgs e)&#xD;&#xA;{&#xD;&#xA;&#x9;var url = (string)ModelPartRemarks.GetCurrentColumnValue(&quot;URL&quot;);&#xD;&#xA;&#x9;var annotationTextLabel = (XRLabel)sender;&#xD;&#xA;&#x9;annotationTextLabel.NavigateUrl = url;&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;private void AnnotationTypeIcon_BeforePrint(object sender, System.Drawing.Printing.PrintEventArgs e)&#xD;&#xA;{&#xD;&#xA;&#x9;var type = (RType)ModelPartRemarks.GetCurrentColumnValue(&quot;Type&quot;);&#xD;&#xA;&#x9;var iconPicture = (XRPictureBox)sender;&#xD;&#xA;&#xD;&#xA;&#x9;if (type == null)&#xD;&#xA;&#x9;{&#xD;&#xA;&#x9;&#x9;iconPicture.ImageSource = null;&#xD;&#xA;&#x9;&#x9;return;&#xD;&#xA;&#x9;}&#xD;&#xA;&#xD;&#xA;&#x9;var imageResourceKey = &quot;typeIcon&quot; + type.Id.ToString();&#xD;&#xA;&#x9;iconPicture.ImageSource = GetImage(imageResourceKey, type.Icon);&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;private void StatePictureBox_BeforePrint(object sender, System.Drawing.Printing.PrintEventArgs e)&#xD;&#xA;{&#xD;&#xA;&#x9;var state = (INUserState)ModelPartRemarks.GetCurrentColumnValue(&quot;State&quot;);&#xD;&#xA;&#x9;var iconPicture = (XRPictureBox)sender;&#xD;&#xA;&#xD;&#xA;&#x9;if (state == null)&#xD;&#xA;&#x9;{&#xD;&#xA;&#x9;&#x9;iconPicture.ImageSource = null;&#xD;&#xA;&#x9;&#x9;return;&#xD;&#xA;&#x9;}&#xD;&#xA;&#xD;&#xA;&#x9;var imageResourceKey = &quot;stateIcon&quot; + state.Id.ToString();&#xD;&#xA;&#x9;iconPicture.ImageSource = GetImage(imageResourceKey, state.Icon);&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;private void FillReportHeaderAndFooter(IModelStorage modelStorage, CoordinationModelLoadingParams modelLoadingParams)&#xD;&#xA;{&#xD;&#xA;&#x9;HeaderLabel.ForeColor = ColorScheme.AccentColor.ToDrawingColor();&#xD;&#xA;&#x9;DetailHeader.BackColor = ColorScheme.AccentColor.ToDrawingColor();&#xD;&#xA;&#xD;&#xA;&#x9;ProjectNameLabel.Text = modelLoadingParams.Project.Title;&#xD;&#xA;&#xD;&#xA;&#x9;ModelNameLabel.Text = string.Format(&#xD;&#xA;&#x9;&#x9;&quot;{0} от {1:g}&quot;,&#xD;&#xA;&#x9;&#x9;modelLoadingParams.CoordModel.Title,&#xD;&#xA;&#x9;&#x9;modelStorage.GetVersions().Last().ToLocalTime());&#xD;&#xA;&#xD;&#xA;&#x9;ModelNameLabel.NavigateUrl = Context.GetPilotUrl(modelLoadingParams.CoordModel.Id);&#xD;&#xA;&#xD;&#xA;&#x9;ModelPartsLabel.Text = string.Join(&#xD;&#xA;&#x9;&#x9;&quot;, &quot;,&#xD;&#xA;&#x9;&#x9;modelLoadingParams.ModelPartsToLoad.Select(x =&gt; x.Title).OrderBy(x =&gt; x));&#xD;&#xA;&#xD;&#xA;&#x9;var currentUser = Context.CurrentPerson;&#xD;&#xA;&#x9;FooterInfoLabel.Text = string.Format(&#xD;&#xA;&#x9;&#x9;&quot;Отчёт построен {0:g} пользователем {1} ({2})&quot;,&#xD;&#xA;&#x9;&#x9;DateTime.Now.ToLocalTime(),&#xD;&#xA;&#x9;&#x9;currentUser.DisplayName,&#xD;&#xA;&#x9;&#x9;currentUser.MainPosition.Title);&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;private static RObject GetRealObject(RObject shortCutObj)&#xD;&#xA;{&#xD;&#xA;&#x9;object idValue;&#xD;&#xA;&#x9;Guid realdModelPartId;&#xD;&#xA;&#x9;shortCutObj.Attributes.TryGetValue(SystemAttributes.SHORTCUT_OBJECT_ID, out idValue);&#xD;&#xA;&#x9;if (Guid.TryParse(idValue.ToString(), out realdModelPartId))&#xD;&#xA;&#x9;{&#xD;&#xA;&#x9;&#x9;var realObj = new ReportContext().GetObject(realdModelPartId);&#xD;&#xA;&#x9;&#x9;if (!realObj.IsInRecycleBin)&#xD;&#xA;&#x9;&#x9;&#x9;return realObj;&#xD;&#xA;&#x9;}&#xD;&#xA;&#x9;return null;&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;private void FillReportDataSource(IModelStorage modelStorage, CoordinationModelLoadingParams loadingParams)&#xD;&#xA;{&#xD;&#xA;&#x9;UserStates = ContextWrapper.Instance.GetRepository().GetUserStates().ToList();&#xD;&#xA;&#x9;ModelPartRemarks.DataMember = &quot;Remarks&quot;;&#xD;&#xA;&#xD;&#xA;&#x9;var result = new List&lt;ReportModelPart&gt;();&#xD;&#xA;&#xD;&#xA;&#x9;foreach (var modelPart in loadingParams.ModelPartsToLoad)&#xD;&#xA;&#x9;{&#xD;&#xA;&#x9;&#x9;var remarksFolderObject = modelPart.Children.FirstOrDefault(x =&gt; x.Type.Name == BimSystemTypeNames.BIM_MODEL_REMARKS_FOLDER);&#xD;&#xA;&#x9;&#x9;var remarksTypesIds = remarksFolderObject != null&#xD;&#xA;&#x9;&#x9;&#x9;? remarksFolderObject.Type.Children.ToList()&#xD;&#xA;&#x9;&#x9;&#x9;: new List&lt;RType&gt;();&#xD;&#xA;&#xD;&#xA;&#x9;&#x9;var remarks = remarksFolderObject != null&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;? remarksFolderObject.Children&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;.Where(x =&gt; remarksTypesIds.FirstOrDefault(t =&gt; t.Id == x.Type.Id) != null)&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;.Select(x =&gt; ToReportRemark(x, modelStorage, modelPart))&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;.Where(x =&gt; x != null)&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;.ToList()&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;: null;&#xD;&#xA;&#xD;&#xA;&#x9;&#x9;var reportModelPart = new ReportModelPart()&#xD;&#xA;&#x9;&#x9;{&#xD;&#xA;&#x9;&#x9;&#x9;Name = modelPart.Title,&#xD;&#xA;&#x9;&#x9;&#x9;Remarks = remarks,&#xD;&#xA;&#x9;&#x9;&#x9;Error = remarks == null || !remarks.Any() ? &quot;&lt;нет данных для отображения&gt;&quot; : null,&#xD;&#xA;&#x9;&#x9;};&#xD;&#xA;&#xD;&#xA;&#x9;&#x9;result.Add(reportModelPart);&#xD;&#xA;&#x9;}&#xD;&#xA;&#xD;&#xA;&#x9;DataSource = result.OrderBy(x =&gt; x.Name);&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;private ReportRemark ToReportRemark(&#xD;&#xA;&#x9;&#x9;&#x9;RObject remarkObject,&#xD;&#xA;&#x9;&#x9;&#x9;IModelStorage modelStorage,&#xD;&#xA;&#x9;&#x9;&#x9;RObject modelPart)&#xD;&#xA;{&#xD;&#xA;&#x9;var actualVer = modelStorage.GetVersions().Last();&#xD;&#xA;&#xD;&#xA;&#x9;var bimObjectId = TryGetGuidValue(remarkObject, &quot;bimObjectId&quot;);&#xD;&#xA;&#x9;var bimElement = bimObjectId.HasValue ? modelStorage.LoadElements(modelPart.Id, actualVer).FirstOrDefault(el =&gt; el.Id.ElementId == bimObjectId.Value) : null;&#xD;&#xA;&#x9;var elementName = bimElement != null&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;? bimElement.Name&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;: &quot;&lt;нет&gt;&quot;;&#xD;&#xA;&#xD;&#xA;&#x9;var responsiblePositionsIds = TryGetValue(remarkObject, &quot;remark_responsible&quot;) as int[] ?? Array.Empty&lt;int&gt;();&#xD;&#xA;&#x9;var responsiblePersons = responsiblePositionsIds&#xD;&#xA;&#x9;&#x9;.Select(x =&gt; Context.GetPersonOnPosition(Context.GetOrganisationUnit(x).Id))&#xD;&#xA;&#x9;&#x9;.ToList();&#xD;&#xA;&#xD;&#xA;&#x9;var stateAttr = remarkObject.Type.Attributes.FirstOrDefault(x =&gt; x.Type == MAttrType.UserState);&#xD;&#xA;&#xD;&#xA;&#x9;var stateId = stateAttr != null&#xD;&#xA;&#x9;&#x9;? TryGetGuidValue(remarkObject, stateAttr.Name)&#xD;&#xA;&#x9;&#x9;: null;&#xD;&#xA;&#xD;&#xA;&#x9;if (stateId.HasValue &amp;&amp; stateId.Value == DELETED_STATE_ID)&#xD;&#xA;&#x9;&#x9;return null;&#xD;&#xA;&#xD;&#xA;&#x9;var state = stateId.HasValue &amp;&amp; stateId.Value != Ascon.Pilot.DataClasses.SystemStates.NONE_STATE_ID&#xD;&#xA;&#x9;&#x9;? UserStates.FirstOrDefault(x =&gt; x.Id == stateId.Value)&#xD;&#xA;&#x9;&#x9;: null;&#xD;&#xA;&#xD;&#xA;&#x9;var author = string.Format(&#xD;&#xA;&#x9;&#x9;&quot;{0} ({1})&quot;,&#xD;&#xA;&#x9;&#x9;remarkObject.Creator.DisplayName,&#xD;&#xA;&#x9;&#x9;remarkObject.Creator.MainPosition.Title);&#xD;&#xA;&#xD;&#xA;&#x9;var responsible = string.Format(&#xD;&#xA;&#x9;&#x9;&quot;{0}&quot;,&#xD;&#xA;&#x9;&#x9;responsiblePersons.Any()&#xD;&#xA;&#x9;&#x9;&#x9;? string.Join(&quot;; &quot;, responsiblePersons&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;.Select(x =&gt; string.Format(&quot;{0} ({1})&quot;, x.DisplayName, x.MainPosition.Title)))&#xD;&#xA;&#x9;&#x9;&#x9;: &quot;&lt;нет&gt;&quot;);&#xD;&#xA;&#xD;&#xA;&#x9;var reportRemark = new ReportRemark()&#xD;&#xA;&#x9;{&#xD;&#xA;&#x9;&#x9;Id = remarkObject.Id,&#xD;&#xA;&#x9;&#x9;URL = Context.GetPilotUrl(remarkObject.Id),&#xD;&#xA;&#x9;&#x9;Type = remarkObject.Type,&#xD;&#xA;&#x9;&#x9;State = state,&#xD;&#xA;&#x9;&#x9;Created = remarkObject.CreatedUtc.ToLocalTime().ToString(&quot;g&quot;),&#xD;&#xA;&#x9;&#x9;Author = author,&#xD;&#xA;&#x9;&#x9;Responsible = responsible,&#xD;&#xA;&#x9;&#x9;Description = remarkObject.Title,&#xD;&#xA;&#x9;&#x9;ElementName = elementName,&#xD;&#xA;&#x9;};&#xD;&#xA;&#xD;&#xA;&#x9;return reportRemark;&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;private object TryGetValue(RObject source, string attrName)&#xD;&#xA;{&#xD;&#xA;&#x9;object value;&#xD;&#xA;&#x9;return source.Attributes.TryGetValue(attrName, out value)&#xD;&#xA;&#x9;&#x9;&#x9;? value&#xD;&#xA;&#x9;&#x9;&#x9;: null;&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;private Guid? TryGetGuidValue(RObject source, string attrName)&#xD;&#xA;{&#xD;&#xA;&#x9;var objValue = TryGetValue(source, attrName);&#xD;&#xA;&#xD;&#xA;&#x9;if (objValue == null)&#xD;&#xA;&#x9;&#x9;return null;&#xD;&#xA;&#xD;&#xA;&#x9;var guidValue = objValue as Guid?;&#xD;&#xA;&#x9;if (guidValue.HasValue)&#xD;&#xA;&#x9;&#x9;return guidValue;&#xD;&#xA;&#xD;&#xA;&#x9;var strGuidValue = objValue as string;&#xD;&#xA;&#x9;Guid guid;&#xD;&#xA;&#x9;if (Guid.TryParse(strGuidValue, out guid))&#xD;&#xA;&#x9;&#x9;return guid;&#xD;&#xA;&#xD;&#xA;&#x9;return null;&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;class ReportModelPart&#xD;&#xA;{&#xD;&#xA;&#x9;public string Name { get; set; }&#xD;&#xA;&#x9;public string Error { get; set; }&#xD;&#xA;&#x9;public List&lt;ReportRemark&gt; Remarks { get; set; }&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;class ReportRemark&#xD;&#xA;{&#xD;&#xA;&#x9;public Guid Id { get; set; }&#xD;&#xA;&#x9;public string URL { get; set; }&#xD;&#xA;&#x9;public RType Type { get; set; }&#xD;&#xA;&#x9;public INUserState State { get; set; }&#xD;&#xA;&#x9;public string Description { get; set; }&#xD;&#xA;&#x9;public string Author { get; set; }&#xD;&#xA;&#x9;public string Responsible { get; set; }&#xD;&#xA;&#x9;public string Created { get; set; }&#xD;&#xA;&#x9;public string ElementName { get; set; }&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;private ImageSource GetImage(string imageResourceKey, byte[] svgImageBytes)&#xD;&#xA;{&#xD;&#xA;&#x9;ImageSource imageSource;&#xD;&#xA;&#x9;if (ImageResources.Contains(imageResourceKey))&#xD;&#xA;&#x9;{&#xD;&#xA;&#x9;&#x9;imageSource = ImageResources.GetImageSource(imageResourceKey);&#xD;&#xA;&#x9;}&#xD;&#xA;&#x9;else&#xD;&#xA;&#x9;{&#xD;&#xA;&#x9;&#x9;try&#xD;&#xA;&#x9;&#x9;{&#xD;&#xA;&#x9;&#x9;&#x9;using (var stream = new System.IO.MemoryStream(svgImageBytes))&#xD;&#xA;&#x9;&#x9;&#x9;{&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;var svg = DevExpress.Utils.Svg.SvgBitmap.FromStream(stream);&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;imageSource = new ImageSource(svg.Render(null, 1));&#xD;&#xA;&#x9;&#x9;&#x9;}&#xD;&#xA;&#x9;&#x9;}&#xD;&#xA;&#x9;&#x9;catch (Exception)&#xD;&#xA;&#x9;&#x9;{&#xD;&#xA;&#x9;&#x9;&#x9;imageSource = null;&#xD;&#xA;&#x9;&#x9;}&#xD;&#xA;&#xD;&#xA;&#x9;&#x9;ImageResources.Add(new ImageItem(imageResourceKey, imageSource));&#xD;&#xA;&#xD;&#xA;&#x9;}&#xD;&#xA;&#xD;&#xA;&#x9;return imageSource;&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;private IModelStorage LoadModelStorage(CoordinationModelLoadingParams modelLoadingParams)&#xD;&#xA;{&#xD;&#xA;&#x9;IModelStorage modelStorage = null;&#xD;&#xA;&#x9;LongRunning.Start(&#xD;&#xA;&#x9;&#x9;this,&#xD;&#xA;&#x9;&#x9;() =&gt; {&#xD;&#xA;&#x9;&#x9;&#x9;modelStorage = BimReportService.GetModelStorage(modelLoadingParams.CoordModel.Id);&#xD;&#xA;&#x9;&#x9;});&#xD;&#xA;&#xD;&#xA;&#x9;return modelStorage;&#xD;&#xA;}&#xD;&#xA;class CoordinationModelLoadingParams&#xD;&#xA;{&#xD;&#xA;&#x9;public RObject Project { get; private set; }&#xD;&#xA;&#x9;public RObject CoordModel { get; private set; }&#xD;&#xA;&#x9;public RObject[] ModelPartsToLoad { get; private set; }&#xD;&#xA;&#xD;&#xA;&#x9;public static CoordinationModelLoadingParams GetFromReportParams(ParameterCollection reportParams)&#xD;&#xA;&#x9;{&#xD;&#xA;&#x9;&#x9;return GetFromReportParams(reportParams&#xD;&#xA;&#x9;&#x9;&#x9;.OfType&lt;Parameter&gt;()&#xD;&#xA;&#x9;&#x9;&#x9;.Select(x =&gt; x.Value as RObject));&#xD;&#xA;&#x9;}&#xD;&#xA;&#xD;&#xA;&#x9;public static CoordinationModelLoadingParams GetFromReportParams(IEnumerable&lt;RObject&gt; rObjects)&#xD;&#xA;&#x9;{&#xD;&#xA;&#x9;&#x9;//предполагаем, что в качестве параметров отчета могут быть переданы только RObject,&#xD;&#xA;&#x9;&#x9;//которые могут быть отдельными model part'ами, ярлыками или coordination model'ю целиком.&#xD;&#xA;&#x9;&#x9;var sourceObjects = rObjects.Where(x =&gt; x != null)&#xD;&#xA;&#x9;&#x9;&#x9;.ToList();&#xD;&#xA;&#xD;&#xA;&#x9;&#x9;//если в параметрах отчета пришли RObject'ы представляющие собой modelpart'ы или ярлыки..  &#xD;&#xA;&#x9;&#x9;var sourceModelParts = sourceObjects&#xD;&#xA;&#x9;&#x9;&#x9;.Where(x =&gt; x.Type.Name == BimSystemTypeNames.BIM_MODEL_PART || x.Type.Name == SystemTypes.SHORTCUT);&#xD;&#xA;&#xD;&#xA;&#x9;&#x9;var coordinationModel = sourceObjects&#xD;&#xA;&#x9;&#x9;&#x9;.Where(x =&gt; x.Type.Name == BimSystemTypeNames.BIM_COORDINATION_MODEL).FirstOrDefault();&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;&#x9;&#x9;//..то получаем их родительскую coordination model, чтобы строить отчет от неё.&#xD;&#xA;&#x9;&#x9;var sourceCoorinationModel = coordinationModel == null? FindCoordinationModel(sourceModelParts.First()) : coordinationModel;&#xD;&#xA;&#xD;&#xA;&#x9;&#x9;//и запоминаем идентификаторы выбранных частей модели или ярлыков&#xD;&#xA;&#x9;&#x9;var modelPartsToLoad = sourceModelParts;&#xD;&#xA;&#xD;&#xA;&#x9;&#x9;//если в пераметрах отчета не нашлось model part'ов или ярлыков,&#xD;&#xA;&#x9;&#x9;// и поэтому список coordination models пуст,&#xD;&#xA;&#x9;&#x9;// попробуем найти RObject типа coordination model&#xD;&#xA;&#x9;&#x9;// непосредственно в параметрах отчёта&#xD;&#xA;&#x9;&#x9;if (sourceCoorinationModel != null &amp;&amp; modelPartsToLoad.Count() == 0)&#xD;&#xA;&#x9;&#x9;{&#xD;&#xA;&#x9;&#x9;&#x9;//и выбираем идентификаторы всех частей модели и ярлыков&#xD;&#xA;&#x9;&#x9;&#x9;modelPartsToLoad = GetCoordinationModelChildrenRecursive(sourceCoorinationModel);&#xD;&#xA;&#x9;&#x9;}&#xD;&#xA;&#xD;&#xA;&#x9;&#x9;if(sourceCoorinationModel == null &amp;&amp; modelPartsToLoad.Count() == 0)&#xD;&#xA;&#x9;&#x9;{&#xD;&#xA;&#x9;&#x9;&#x9;throw new ReportExpectedException(&quot;В качестве параметра отчёта должна быть выбрана консолидированная модель, часть консолидированной модели или ярлык ссылающийся на неудаленный объект.&quot;);&#xD;&#xA;&#x9;&#x9;}&#xD;&#xA;&#x9;&#x9;&#xD;&#xA;&#xD;&#xA;&#x9;&#x9;// если нам пришли RObject'ы, представляющие собой ярлыки, то получим реальные объекты, на которые они ссылаются, чтобы строить отчет от них&#xD;&#xA;&#x9;&#x9;var modelPartsForReport = modelPartsToLoad.Select(x =&gt; x.Type.Name == SystemTypes.SHORTCUT ? GetRealObject(x) : x)&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;.Where(y=&gt; y != null).ToArray();&#xD;&#xA;&#x9;&#x9;&#xD;&#xA;&#x9;&#x9;if (!modelPartsForReport.Any())&#xD;&#xA;&#x9;&#x9;&#x9;throw new ReportExpectedException(&quot;В качестве параметра отчёта должна быть выбрана консолидированная модель, часть консолидированной модели или ярлык ссылающийся на неудаленный объект.&quot;);&#xD;&#xA;&#x9;&#x9;&#xD;&#xA;&#x9;&#x9;return new CoordinationModelLoadingParams()&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;{&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;Project = sourceCoorinationModel.Parent,&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;CoordModel = sourceCoorinationModel,&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;ModelPartsToLoad = modelPartsForReport,&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;};&#xD;&#xA;&#x9;}&#xD;&#xA;&#xD;&#xA;&#x9;static List&lt;RObject&gt; GetCoordinationModelChildrenRecursive(RObject coordinationModelSource)&#xD;&#xA;    {&#xD;&#xA;            var result = new List&lt;RObject&gt;();&#xD;&#xA;            var queue = new Queue&lt;RObject&gt;();&#xD;&#xA;&#xD;&#xA;            FillQueue(queue, coordinationModelSource.Children, result);&#xD;&#xA;&#xD;&#xA;            while (queue.Any())&#xD;&#xA;            {&#xD;&#xA;                var folder = queue.Dequeue();&#xD;&#xA;                FillQueue(queue, folder.Children, result);&#xD;&#xA;            }&#xD;&#xA;&#xD;&#xA;            return result;&#xD;&#xA;    }&#xD;&#xA;&#xD;&#xA;    static void FillQueue(Queue&lt;RObject&gt; inQueue, IEnumerable&lt;RObject&gt; children, List&lt;RObject&gt; outResult)&#xD;&#xA;    {&#xD;&#xA;                foreach (var child in children)&#xD;&#xA;                {&#xD;&#xA;                    if (child.Type.Name == SystemTypes.SHORTCUT)&#xD;&#xA;                    {&#xD;&#xA;                    &#x9;var obj = GetRealObject(child);&#xD;&#xA;                    &#x9;outResult.Add(obj);&#xD;&#xA;                    }&#xD;&#xA;                    else if (child.Type.Name == BimSystemTypeNames.BIM_MODEL_PART)&#xD;&#xA;                    {&#xD;&#xA;                        outResult.Add(child);&#xD;&#xA;                    }&#xD;&#xA;                    else if (child.Type.Name == BimSystemTypeNames.BIM_MODEL_PART_FOLDER)&#xD;&#xA;                    {&#xD;&#xA;                        inQueue.Enqueue(child);&#xD;&#xA;                    }&#xD;&#xA;                }&#xD;&#xA;    }&#xD;&#xA;&#xD;&#xA;     static RObject FindCoordinationModel(RObject child)&#xD;&#xA;        {&#xD;&#xA;            var queue = new Queue&lt;RObject&gt;();&#xD;&#xA;            queue.Enqueue(child.Parent);&#xD;&#xA;&#xD;&#xA;            while (queue.Any())&#xD;&#xA;            {&#xD;&#xA;                var item = queue.Dequeue();&#xD;&#xA;&#xD;&#xA;                if (item.Type.Name == BimSystemTypeNames.BIM_COORDINATION_MODEL)&#xD;&#xA;                {&#xD;&#xA;                    return item;&#xD;&#xA;                }&#xD;&#xA;                else if (item.Type.Name == BimSystemTypeNames.BIM_MODEL_PART_FOLDER)&#xD;&#xA;                {&#xD;&#xA;                    queue.Enqueue(item.Parent);&#xD;&#xA;                }&#xD;&#xA;            }&#xD;&#xA;            return null;&#xD;&#xA;        }&#xD;&#xA;}&#xD;&#xA;" Margins="75, 75, 75, 75" PaperKind="A4" PageWidth="827" PageHeight="1169" Version="20.1" DataSource="#Ref-0" Font="Segoe UI, 9.75pt, charSet=204">
