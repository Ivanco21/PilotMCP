<?xml version="1.0" encoding="utf-8"?>
<XtraReportsLayoutSerializer SerializerVersion="20.1.8.0" Ref="1" ControlType="DevExpress.XtraReports.UI.XtraReport, DevExpress.XtraReports.v20.1, Version=20.1.8.0, Culture=neutral, PublicKeyToken=b88d1754d700e49a" Name="PilotReport" ScriptsSource="using Ascon.Pilot.ProjectionsRepository;&#xD;&#xA;using Ascon.Pilot.ClientCore.Search;&#xD;&#xA;using System;&#xD;&#xA;using System.Linq;&#xD;&#xA;using System.Collections.Generic;&#xD;&#xA;using Ascon.Pilot.DataClasses;&#xD;&#xA;using Ascon.Pilot.Client.Search;&#xD;&#xA;using Ascon.Pilot.Common.Search;&#xD;&#xA;using Ascon.Pilot.Pilot.Reports;&#xD;&#xA;&#xD;&#xA;ReportContext context = new ReportContext();&#xD;&#xA;Dictionary&lt;Guid, INUserState&gt; userStates;&#xD;&#xA;&#xD;&#xA;private void PilotReport_DataSourceDemanded(object sender, System.EventArgs e) &#xD;&#xA;{&#xD;&#xA;&#x9;userStates = context.GetUserStates().ToDictionary(x =&gt; x.Id);&#xD;&#xA;&#x9;LongRunning.Start(this, () =&gt; {&#xD;&#xA;&#x9;&#x9;var builder = QueryBuilder.CreateEmptyQueryBuilder();&#xD;&#xA;&#x9;&#x9;builder.Must(AttributeFields.OrgUnit(&quot;executor&quot;).Be(context.CurrentPerson.MainPosition.Id));&#xD;&#xA;&#x9;&#x9;builder.Must(AttributeFields.DateTime(&quot;dateOfAssignment&quot;).Exists());&#xD;&#xA;&#x9;&#x9;builder.MustNot(AttributeFields.DateTime(&quot;dateOfCompletion&quot;).Exists());&#xD;&#xA;&#x9;&#x9;builder.MustNot(AttributeFields.State(&quot;state&quot;).Be(SystemStates.TASK_REVOKED_STATE_ID));&#xD;&#xA;&#x9;&#x9;context.Objects = context.GetObjects(builder);&#x9;&#xD;&#xA;&#x9;&#x9;DataSource = context;&#xD;&#xA;&#x9;});&#xD;&#xA;}&#xD;&#xA;private void TaskDateOfAssignment_GetValue(object sender, DevExpress.XtraReports.UI.GetValueEventArgs e) {&#xD;&#xA;&#x9;var value = GetAttributeValue&lt;DateTime&gt;(e, &quot;dateOfAssignment&quot;);&#xD;&#xA;&#x9;e.Value = value != default(DateTime) ? (DateTime?)value.ToLocalTime() : null;&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;private void TaskDeadline_GetValue(object sender, DevExpress.XtraReports.UI.GetValueEventArgs e) {&#xD;&#xA;&#x9;var value = GetAttributeValue&lt;DateTime&gt;(e, &quot;deadlineDate&quot;);&#xD;&#xA;&#x9;e.Value = value != default(DateTime) &amp;&amp; value != DateTime.MaxValue ? (DateTime?)value.ToLocalTime() : null;&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;private string GetOrgUnitAttributeValue(GetValueEventArgs e, string attributeName)&#xD;&#xA;{&#xD;&#xA;&#x9;var ids = GetAttributeValue&lt;int[]&gt;(e, attributeName);&#xD;&#xA;&#x9;var orgUnits = ids.Select(context.GetOrganisationUnit);&#xD;&#xA;&#x9;return string.Join(&quot;, &quot;, orgUnits.Select(x =&gt; x.Person.DisplayName));&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;private T GetAttributeValue&lt;T&gt;(GetValueEventArgs e, string attributeName)&#xD;&#xA;{&#xD;&#xA;&#x9;var obj = (RObject)e.Row;&#xD;&#xA;&#x9;object value;&#xD;&#xA;&#x9;if(!obj.Attributes.TryGetValue(attributeName, out value))&#xD;&#xA;&#x9;&#x9;return default(T);&#xD;&#xA;&#x9;return (T)value;&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;private void TaskDescription_GetValue(object sender, DevExpress.XtraReports.UI.GetValueEventArgs e) {&#xD;&#xA;&#x9;const int MAX_LENGTH = 100;&#xD;&#xA;&#x9;var value = GetAttributeValue&lt;string&gt;(e, &quot;description&quot;);&#xD;&#xA;&#x9;if(value != null &amp;&amp; value.Length &gt; MAX_LENGTH)&#xD;&#xA;&#x9;&#x9;value = value.Substring(0, MAX_LENGTH) + &quot;...&quot;;&#xD;&#xA;&#x9;e.Value = value;&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;private void TaskInitiator_GetValue(object sender, DevExpress.XtraReports.UI.GetValueEventArgs e) {&#xD;&#xA;&#x9;e.Value = GetOrgUnitAttributeValue(e, &quot;initiator&quot;);&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;private void TaskStateName_GetValue(object sender, DevExpress.XtraReports.UI.GetValueEventArgs e) {&#xD;&#xA;&#x9;var stateId = GetAttributeValue&lt;Guid&gt;(e, &quot;state&quot;);&#xD;&#xA;&#x9;INUserState state;&#xD;&#xA;&#x9;if(userStates.TryGetValue(stateId, out state)) {&#xD;&#xA;&#x9;&#x9;e.Value = state.Title;&#xD;&#xA;&#x9;}&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;private void TaskTitle_GetValue(object sender, DevExpress.XtraReports.UI.GetValueEventArgs e) {&#xD;&#xA;&#x9;e.Value = GetAttributeValue&lt;string&gt;(e, &quot;title&quot;);&#xD;&#xA;}&#xD;&#xA;" Margins="50, 50, 50, 50" PaperKind="A4Rotated" PageWidth="1169" PageHeight="827" Version="20.1" DataSource="#Ref-0">
