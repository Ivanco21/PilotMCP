<?xml version="1.0" encoding="utf-8"?>
<XtraReportsLayoutSerializer SourceReportTypesNames="bim_clashDetectionJournal" SerializerVersion="20.1.8.0" Ref="1" ControlType="Ascon.Pilot.Pilot.Reports.PilotReport, Ascon.Pilot.Pilot, Version=0.0.0.0, Culture=neutral, PublicKeyToken=null" Name="PilotReport" ScriptsSource="using Ascon.Pilot.Common.Search;&#xD;&#xA;using Ascon.Pilot.ClientCore.Search;&#xD;&#xA;using Ascon.Pilot.DataClasses;&#xD;&#xA;using System.Linq;&#xD;&#xA;using System.Collections.Generic;&#xD;&#xA;using Ascon.Pilot.ProjectionsRepository;&#xD;&#xA;using Ascon.Pilot.Theme.ColorScheme;&#xD;&#xA;using Ascon.Pilot.Pilot.Reports;&#xD;&#xA;using DevExpress.XtraReports.Parameters;&#xD;&#xA;using DevExpress.XtraPrinting.Drawing;&#xD;&#xA;using Ascon.Pilot.BimViewer.Reports;&#xD;&#xA;using Ascon.Pilot.BimUtils;&#xD;&#xA;using Ascon.Pilot.Client;&#xD;&#xA;using Ascon.Pilot.SDK;&#xD;&#xA;using Ascon.Pilot.PluginLoader.CrossDomainObjects;&#xD;&#xA;using Ascon.Pilot.VisualElements.Tools;&#xD;&#xA;&#xD;&#xA;ReportContext Context = new ReportContext();&#xD;&#xA;List&lt;INUserState&gt; UserStates = new List&lt;INUserState&gt;();&#xD;&#xA;&#xD;&#xA;private void PilotReport_DataSourceDemanded(object sender, System.EventArgs e) &#xD;&#xA;{&#xD;&#xA;&#x9;var journalObjects = Parameters&#xD;&#xA;&#x9;&#x9;.OfType&lt;Parameter&gt;()&#xD;&#xA;&#x9;&#x9;.Select(x =&gt; x.Value as RObject)&#xD;&#xA;&#x9;&#x9;.Where(x =&gt; x != null &amp;&amp; x.Type.Name == BimSystemTypeNames.BIM_MODEL_CHECKER_CLASH_DETECTION_JOURNAL)&#xD;&#xA;&#x9;&#x9;.ToList();&#xD;&#xA;&#xD;&#xA;&#x9;if (!journalObjects.Any())&#xD;&#xA;&#x9;&#x9;throw new ReportExpectedException(&quot;Журнал не выбран.&quot;);&#xD;&#xA;&#x9;&#xD;&#xA;&#x9;RObject coordinationModelObject = null;&#xD;&#xA;&#x9;var selectedJournalsSearchSets = journalObjects&#xD;&#xA;&#x9;&#x9;.SelectMany(journal =&gt; &#xD;&#xA;&#x9;&#x9;&#x9;&#x9;{&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;var leftSearchSetIds = GetRelationsByName(journal,BimSystemRelationNames.BIM_LEFT_SEARCH_SET_RELATIONS);&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;var rightSearchSetIds = GetRelationsByName(journal,BimSystemRelationNames.BIM_RIGHT_SEARCH_SET_RELATIONS);&#xD;&#xA;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;var searchSets = new List&lt;RObject&gt;();&#xD;&#xA;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;searchSets.AddRange(leftSearchSetIds.Select(x=&gt; GetSearchSetObj(x)));&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;searchSets.AddRange(rightSearchSetIds.Select(x=&gt; GetSearchSetObj(x)));&#xD;&#xA;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;var journalsFolderObject = journal.Parent;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;coordinationModelObject = journalsFolderObject.Parent;&#xD;&#xA;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;return searchSets;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;})&#xD;&#xA;&#x9;&#x9;.ToList();&#xD;&#xA;&#xD;&#xA;&#x9;FillReportHeaderAndFooter(coordinationModelObject);&#xD;&#xA;&#x9;FillReportDataSource(journalObjects);&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;private void JournalNameLabel_BeforePrint(object sender, System.Drawing.Printing.PrintEventArgs e) &#xD;&#xA;{&#xD;&#xA;&#x9;var url = (string)GetCurrentColumnValue(&quot;URL&quot;);&#xD;&#xA;&#x9;var nameLabel = (XRLabel)sender;&#xD;&#xA;&#x9;nameLabel.NavigateUrl = url;&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;private void StatePictureBox_BeforePrint(object sender, System.Drawing.Printing.PrintEventArgs e) &#xD;&#xA;{&#xD;&#xA;&#x9;var state = (INUserState)IssuesDetailReport.GetCurrentColumnValue(&quot;State&quot;);&#xD;&#xA;&#x9;var iconPicture = (XRPictureBox)sender;&#xD;&#xA;&#xD;&#xA;&#x9;if(state == null)&#xD;&#xA;&#x9;{&#xD;&#xA;&#x9;&#x9;iconPicture.ImageSource = null;&#xD;&#xA;&#x9;&#x9;return;&#xD;&#xA;&#x9;}&#xD;&#xA;&#xD;&#xA;&#x9;var imageResourceKey = &quot;stateIcon&quot; + state.Id.ToString();&#xD;&#xA;&#x9;iconPicture.ImageSource = GetImage(imageResourceKey, state.Icon);&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;private void IssueStatePanel_BeforePrint(object sender, System.Drawing.Printing.PrintEventArgs e)&#xD;&#xA;{&#xD;&#xA;&#x9;var state = (INUserState)IssuesDetailReport.GetCurrentColumnValue(&quot;State&quot;);&#xD;&#xA;&#x9;var statePanel = (XRPanel)sender;&#xD;&#xA;&#xD;&#xA;&#x9;if(state == null)&#xD;&#xA;&#x9;{&#xD;&#xA;&#x9;&#x9;statePanel.BackColor = System.Drawing.Color.White;&#xD;&#xA;&#x9;&#x9;return;&#xD;&#xA;&#x9;}&#xD;&#xA;&#xD;&#xA;&#x9;var stateColor = Ascon.Pilot.Theme.Tools.UserStateColorThemeExtensions.GetColor((int)state.Color, Ascon.Pilot.Themes.ThemeNames.Jedi).ToDrawingColor();&#xD;&#xA;&#x9;statePanel.BackColor = stateColor;&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;private void FillReportHeaderAndFooter(RObject coordinationModelObj)&#xD;&#xA;{&#xD;&#xA;&#x9;HeaderLabel.ForeColor = ColorScheme.AccentColor.ToDrawingColor();&#xD;&#xA;&#x9;DetailHeader.BackColor = ColorScheme.AccentColor.ToDrawingColor();&#xD;&#xA;&#xD;&#xA;&#x9;ProjectNameLabel.Text = coordinationModelObj.Parent.Title;&#xD;&#xA;&#xD;&#xA;&#x9;ModelNameLabel.Text = coordinationModelObj.Title;&#xD;&#xA;&#xD;&#xA;&#x9;ModelNameLabel.NavigateUrl = Context.GetPilotUrl(coordinationModelObj.Id);&#xD;&#xA;&#xD;&#xA;&#x9;var currentUser = Context.CurrentPerson;&#xD;&#xA;&#x9;FooterInfoLabel.Text = string.Format(&#xD;&#xA;&#x9;&#x9;&quot;Отчёт построен {0:g} пользователем {1} ({2})&quot;,&#xD;&#xA;&#x9;&#x9;DateTime.Now.ToLocalTime(),&#xD;&#xA;&#x9;&#x9;currentUser.DisplayName,&#xD;&#xA;&#x9;&#x9;currentUser.MainPosition.Title);&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;private RObject GetSearchSetObj(Guid? nullableId)&#xD;&#xA;{&#x9;&#xD;&#xA;&#x9;if (!nullableId.HasValue) return null;&#x9;&#xD;&#xA;&#x9;return Context.GetObject(nullableId.Value);&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;private void FillReportDataSource(List&lt;RObject&gt; jounrnals)&#xD;&#xA;{&#xD;&#xA;&#x9;UserStates = ContextWrapper.Instance.GetRepository().GetUserStates().ToList();&#xD;&#xA;&#x9;IssuesDetailReport.DataMember = &quot;Issues&quot;; &#xD;&#xA;&#x9;DataSource = PopulateJournals(jounrnals);&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;private List&lt;JournalItem&gt; PopulateJournals(List&lt;RObject&gt; journals)&#xD;&#xA;{&#xD;&#xA;&#x9;var journalItems = journals&#xD;&#xA;&#x9;&#x9;.Select(journalObject =&gt;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;{&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;var leftSearchSetIds = GetRelationsByName(journalObject , BimSystemRelationNames.BIM_LEFT_SEARCH_SET_RELATIONS);&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;var rightSearchSetIds = GetRelationsByName(journalObject , BimSystemRelationNames.BIM_RIGHT_SEARCH_SET_RELATIONS);&#xD;&#xA;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;var searchSets = new List&lt;RObject&gt;();&#xD;&#xA;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;searchSets.AddRange(leftSearchSetIds.Select(x=&gt; GetSearchSetObj(x)));&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;searchSets.AddRange(rightSearchSetIds.Select(x=&gt; GetSearchSetObj(x)));&#xD;&#xA;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;var searchSetNames = new HashSet&lt;string&gt;(searchSets.Select(x=&gt; x.Title));&#xD;&#xA;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;var issues = PopulateIssues(journalObject);&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;var updated = TryGetValue(journalObject, BimSystemAttributes.BIM_COLLISIONS_JOURNAL_ATTRIBUTE_UPDATED) as DateTime?;&#xD;&#xA;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;var journalItem = new JournalItem()&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;{&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;Name = journalObject.Title,&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;URL = Context.GetPilotUrl(journalObject.Id),&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;SearchSets = string.Join(&quot;, &quot;, searchSetNames),&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;Updated = updated != null ? updated.Value.ToString(&quot;g&quot;) : &quot;&lt;проверка ни разу не выполнялась&gt;&quot;,&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;Issues =  issues,&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;Total = string.Format(&quot;Всего проблем: {0}&quot;, issues.Count),&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;};&#xD;&#xA;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;return journalItem;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;})&#xD;&#xA;&#x9;&#x9;.ToList();&#xD;&#xA;&#xD;&#xA;&#x9;return journalItems;&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;private List&lt;IssueItem&gt; PopulateIssues(RObject journalObject)&#xD;&#xA;{&#xD;&#xA;&#x9;var journalDataObject = DataObjects.Create(journalObject.GetSource().Source, ContextWrapper.Instance.GetRepository().AsBackend());&#xD;&#xA;&#x9;var results = BimReportJournalsService.Instance.GetCollisionResults(journalDataObject);&#xD;&#xA;&#xD;&#xA;&#x9;var issuesCollection = new List&lt;IssueItem&gt;();&#xD;&#xA;&#x9;&#xD;&#xA;&#x9;foreach (var issue in results.Collisions)&#xD;&#xA;&#x9;{&#xD;&#xA;&#x9;&#x9;var stateId = issue.StateId;&#xD;&#xA;&#x9;&#x9;var state = stateId != Ascon.Pilot.DataClasses.SystemStates.NONE_STATE_ID&#xD;&#xA;&#x9;&#x9;&#x9;? UserStates.FirstOrDefault(x=&gt;x.Id == stateId)&#xD;&#xA;&#x9;&#x9;&#x9;: null;&#xD;&#xA;&#xD;&#xA;&#x9;&#x9;issuesCollection.Add(new IssueItem()&#xD;&#xA;&#x9;&#x9;{&#xD;&#xA;&#x9;&#x9;&#x9;Description = issue.Description,&#xD;&#xA;&#xD;&#xA;&#x9;&#x9;&#x9;State = state,&#xD;&#xA;&#x9;&#x9;&#x9;  &#xD;&#xA;&#x9;&#x9;&#x9;LeftNodeId = issue.FirstId,&#xD;&#xA;&#x9;&#x9;&#x9;LeftNodeDescription = issue.FirstType,&#xD;&#xA;&#xD;&#xA;&#x9;&#x9;&#x9;RightNodeId = issue.SecondId,&#xD;&#xA;&#x9;&#x9;&#x9;RightNodeDescription = issue.SecondType,&#xD;&#xA;&#x9;&#x9;});&#xD;&#xA;&#x9;}&#xD;&#xA;&#x9;&#xD;&#xA;&#x9;return issuesCollection;&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;class JournalItem&#xD;&#xA;{&#xD;&#xA;&#x9;public string Name { get; set; }&#xD;&#xA;&#x9;public string URL { get; set; }&#xD;&#xA;&#x9;public string SearchSets { get; set; }&#xD;&#xA;&#x9;public string Updated { get; set; }&#xD;&#xA;&#x9;public List&lt;IssueItem&gt; Issues {get; set; }&#xD;&#xA;&#x9;public string Total { get; set; }&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;class IssueItem&#xD;&#xA;{&#xD;&#xA;&#x9;public string Description { get; set; }&#xD;&#xA;&#xD;&#xA;&#x9;public Guid LeftNodeId { get; set; }&#xD;&#xA;&#x9;public string LeftNodeDescription { get; set; }&#xD;&#xA;&#xD;&#xA;&#x9;public Guid RightNodeId { get; set; }&#xD;&#xA;&#x9;public string RightNodeDescription { get; set; }&#xD;&#xA;&#xD;&#xA;&#x9;public INUserState State { get; set; }&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;private object TryGetValue(RObject source, string attrName)&#xD;&#xA;{&#xD;&#xA;&#x9;object value;&#xD;&#xA;&#x9;return source.Attributes.TryGetValue(attrName, out value)&#xD;&#xA;&#x9;&#x9;&#x9;? value&#xD;&#xA;&#x9;&#x9;&#x9;: null;&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;private Guid? TryGetGuidValue(RObject source, string attrName)&#xD;&#xA;{&#xD;&#xA;&#x9;var objValue = TryGetValue(source, attrName);&#xD;&#xA;&#xD;&#xA;&#x9;if(objValue == null)&#xD;&#xA;&#x9;&#x9;return null;&#xD;&#xA;&#xD;&#xA;&#x9;var guidValue = objValue as Guid?;&#xD;&#xA;&#x9;if(guidValue.HasValue)&#xD;&#xA;&#x9;&#x9;return guidValue;&#xD;&#xA;&#x9;&#xD;&#xA;&#x9;var strGuidValue = objValue as string;&#xD;&#xA;&#x9;Guid guid;&#xD;&#xA;&#x9;if(Guid.TryParse(strGuidValue, out guid))&#xD;&#xA;&#x9;&#x9;return guid;&#xD;&#xA;&#xD;&#xA;&#x9;return null;&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;private List&lt;Guid&gt; GetRelationsByName(RObject source, string relationName)&#xD;&#xA;{&#xD;&#xA;&#x9;var result = source.Relations&#xD;&#xA;&#x9;&#x9;.Where(x=&gt; x.Name == relationName)&#xD;&#xA;&#x9;&#x9;.Select(x=&gt; x.Target.Id)&#xD;&#xA;&#x9;&#x9;.ToList();&#xD;&#xA;&#xD;&#xA;&#x9;return result;&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;private ImageSource GetImage(string imageResourceKey, byte[] svgImageBytes)&#xD;&#xA;{&#xD;&#xA;&#x9;ImageSource imageSource;&#xD;&#xA;&#x9;if(ImageResources.Contains(imageResourceKey))&#xD;&#xA;&#x9;{&#xD;&#xA;&#x9;&#x9;imageSource = ImageResources.GetImageSource(imageResourceKey);&#xD;&#xA;&#x9;}&#xD;&#xA;&#x9;else&#xD;&#xA;&#x9;{&#xD;&#xA;&#x9;&#x9;try&#xD;&#xA;&#x9;&#x9;{&#xD;&#xA;&#x9;&#x9;&#x9;using (var stream = new System.IO.MemoryStream(svgImageBytes))&#xD;&#xA;&#x9;&#x9;&#x9;{&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;var svg = DevExpress.Utils.Svg.SvgBitmap.FromStream(stream);&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;imageSource = new ImageSource(svg.Render(null, 1));&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#xD;&#xA;&#x9;&#x9;&#x9;}&#xD;&#xA;&#x9;&#x9;}&#xD;&#xA;&#x9;&#x9;catch (Exception)&#xD;&#xA;&#x9;&#x9;{&#xD;&#xA;&#x9;&#x9;&#x9;imageSource = null;&#xD;&#xA;&#x9;&#x9;}&#xD;&#xA;&#xD;&#xA;&#x9;&#x9;ImageResources.Add(new ImageItem(imageResourceKey, imageSource));&#xD;&#xA;&#x9;&#x9;&#xD;&#xA;&#x9;}&#xD;&#xA;&#xD;&#xA;&#x9;return imageSource;&#xD;&#xA;}&#xD;&#xA;" Margins="75, 75, 76, 75" PaperKind="A4" PageWidth="827" PageHeight="1169" Version="20.1" DataSource="#Ref-0" Font="Segoe UI, 9.75pt, charSet=204">
