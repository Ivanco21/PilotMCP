<?xml version="1.0" encoding="utf-8"?>
<XtraReportsLayoutSerializer SourceReportTypesNames="bim_informationModelCheck" SerializerVersion="20.1.8.0" Ref="1" ControlType="Ascon.Pilot.Pilot.Reports.PilotReport, Ascon.Pilot.Pilot, Version=0.0.0.0, Culture=neutral, PublicKeyToken=null" Name="PilotReport" ScriptsSource="using Ascon.Pilot.Common.Search;&#xD;&#xA;using Ascon.Pilot.ClientCore.Search;&#xD;&#xA;using Ascon.Pilot.DataClasses;&#xD;&#xA;using System.Linq;&#xD;&#xA;using System.Collections.Generic;&#xD;&#xA;using Ascon.Pilot.ProjectionsRepository;&#xD;&#xA;using Ascon.Pilot.Theme.ColorScheme;&#xD;&#xA;using Ascon.Pilot.Pilot.Reports;&#xD;&#xA;using DevExpress.XtraReports.Parameters;&#xD;&#xA;using DevExpress.XtraPrinting.Drawing;&#xD;&#xA;using Ascon.Pilot.BimViewer.Reports;&#xD;&#xA;using Ascon.Pilot.BimUtils;&#xD;&#xA;using Ascon.Pilot.Client;&#xD;&#xA;using Ascon.Pilot.SDK;&#xD;&#xA;using Ascon.Pilot.PluginLoader.CrossDomainObjects;&#xD;&#xA;using Ascon.Pilot.VisualElements.Tools;&#xD;&#xA;&#xD;&#xA;ReportContext Context = new ReportContext();&#xD;&#xA;&#xD;&#xA;private void PilotReport_DataSourceDemanded(object sender, System.EventArgs e) &#xD;&#xA;{&#xD;&#xA;&#x9;var journalObjects = Parameters&#xD;&#xA;&#x9;&#x9;.OfType&lt;Parameter&gt;()&#xD;&#xA;&#x9;&#x9;.Select(x =&gt; x.Value as RObject)&#xD;&#xA;&#x9;&#x9;.Where(x =&gt; x != null &amp;&amp; x.Type.Name == BimSystemTypeNames.BIM_MODEL_CHECK)&#xD;&#xA;&#x9;&#x9;.ToList();&#xD;&#xA;&#xD;&#xA;&#x9;if (!journalObjects.Any())&#xD;&#xA;&#x9;&#x9;throw new ReportExpectedException(&quot;Журнал не выбран.&quot;);&#xD;&#xA;&#x9;&#xD;&#xA;&#x9;FillReportDataSource(journalObjects);&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;private void JournalNameLabel_BeforePrint(object sender, System.Drawing.Printing.PrintEventArgs e) &#xD;&#xA;{&#xD;&#xA;&#x9;var url = (string)GetCurrentColumnValue(&quot;URL&quot;);&#xD;&#xA;&#x9;var nameLabel = (XRLabel)sender;&#xD;&#xA;&#x9;nameLabel.NavigateUrl = url;&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;private void IssueURL_BeforePrint(object sender, System.Drawing.Printing.PrintEventArgs e) &#xD;&#xA;{&#xD;&#xA;&#x9;var url = (string)GetCurrentColumnValue(&quot;URL&quot;);&#xD;&#xA;&#x9;var nameLabel = (XRLabel)sender;&#xD;&#xA;&#x9;nameLabel.NavigateUrl = nameLabel.Text;&#xD;&#xA;&#x9;nameLabel.Text = &quot;ссылка на обьект модели&quot;;&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;private void FillChart(int successed, int failed)&#xD;&#xA;{&#xD;&#xA;       chart1.Series.Clear();&#xD;&#xA;       Series series1 = new Series(&quot;Series 1&quot;, ViewType.Doughnut);&#xD;&#xA;&#xD;&#xA;       // Populate the series with points.&#xD;&#xA;       series1.Points.Add(new SeriesPoint(&quot;Прошли проверку&quot;, successed) { Color = Color.LightGreen});&#xD;&#xA;       series1.Points.Add(new SeriesPoint(&quot;Найденные несоответствия&quot;, failed) { Color = Color.LightCoral});&#xD;&#xA;&#xD;&#xA;       // Add the series to the chart.&#xD;&#xA;       chart1.Series.Add(series1);&#xD;&#xA;&#xD;&#xA;            // Specify the text pattern of series labels.&#xD;&#xA;            series1.Label.TextPattern = &quot;{A}: {VP:P0}&quot;;&#xD;&#xA;&#xD;&#xA;            // Specify how series points are sorted.&#xD;&#xA;            series1.SeriesPointsSorting = SortingMode.Ascending;&#xD;&#xA;            series1.SeriesPointsSortingKey = SeriesPointKey.Argument;&#xD;&#xA;&#xD;&#xA;            // Specify the behavior of series labels.&#xD;&#xA;            ((DoughnutSeriesLabel)series1.Label).Position = PieSeriesLabelPosition.TwoColumns;&#xD;&#xA;            ((DoughnutSeriesLabel)series1.Label).ResolveOverlappingMode = ResolveOverlappingMode.Default;&#xD;&#xA;            ((DoughnutSeriesLabel)series1.Label).ResolveOverlappingMinIndent = 5;&#xD;&#xA;&#xD;&#xA;            // Adjust the view-type-specific options of the series.&#xD;&#xA;            ((DoughnutSeriesView)series1.View).ExplodedPoints.Add(series1.Points[0]);&#xD;&#xA;            ((DoughnutSeriesView)series1.View).ExplodedDistancePercentage = 30;&#xD;&#xA;&#xD;&#xA;            // Access the diagram's options.&#xD;&#xA;            ((SimpleDiagram)chart1.Diagram).Dimension = 3;&#xD;&#xA;&#xD;&#xA;            // Add a title to the chart and hide the legend.&#xD;&#xA;            chart1.Legend.Visibility = DevExpress.Utils.DefaultBoolean.False;&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;private void IssueStatePanel_BeforePrint(object sender, System.Drawing.Printing.PrintEventArgs e)&#xD;&#xA;{&#xD;&#xA;&#x9;var state = (INUserState)IssuesDetailReport.GetCurrentColumnValue(&quot;State&quot;);&#xD;&#xA;&#x9;var statePanel = (XRPanel)sender;&#xD;&#xA;&#xD;&#xA;&#x9;if(state == null)&#xD;&#xA;&#x9;{&#xD;&#xA;&#x9;&#x9;statePanel.BackColor = System.Drawing.Color.White;&#xD;&#xA;&#x9;&#x9;return;&#xD;&#xA;&#x9;}&#xD;&#xA;&#xD;&#xA;&#x9;var stateColor = Ascon.Pilot.Theme.Tools.UserStateColorThemeExtensions.GetColor((int)state.Color, Ascon.Pilot.Themes.ThemeNames.Jedi).ToDrawingColor();&#xD;&#xA;&#x9;statePanel.BackColor = stateColor;&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;private void FillReportHeaderAndFooter(RObject coord, RObject journal)&#xD;&#xA;{&#xD;&#xA;&#x9;if(coord == null || journal == null)&#xD;&#xA;&#x9;&#x9;return;&#xD;&#xA;&#xD;&#xA;&#x9;HeaderLabel.ForeColor = ColorScheme.AccentColor.ToDrawingColor();&#xD;&#xA;&#x9;DetailHeader.BackColor = ColorScheme.AccentColor.ToDrawingColor();&#xD;&#xA;&#xD;&#xA;&#x9;ProjectNameLabel.Text = coord.Parent != null? coord.Parent.Title : string.Empty;&#xD;&#xA;&#x9;JNameLabel.Text = journal.Title;&#xD;&#xA;&#xD;&#xA;&#x9;Updated.Text = DateTime.Now.ToLocalTime().ToString();&#xD;&#xA;&#xD;&#xA;&#x9;var currentUser = Context.CurrentPerson;&#xD;&#xA;&#xD;&#xA;&#x9;FooterInfoLabel.Text = string.Format(&#xD;&#xA;&#x9;&#x9;&quot;Отчёт построен {0:g} пользователем {1} ({2})&quot;,&#xD;&#xA;&#x9;&#x9;DateTime.Now.ToLocalTime(),&#xD;&#xA;&#x9;&#x9;currentUser.DisplayName,&#xD;&#xA;&#x9;&#x9;currentUser.MainPosition.Title);&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;private void FillReportDataSource(List&lt;RObject&gt; jounrnals)&#xD;&#xA;{&#xD;&#xA;&#x9;ChecksDetailReport.DataMember = &quot;Checks&quot;; &#xD;&#xA;&#x9;IssuesDetailReport.DataMember = &quot;Checks.Issues&quot;; &#xD;&#xA;&#x9;DataSource = PopulateJournals(jounrnals);&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;private List&lt;JournalItem&gt; PopulateJournals(List&lt;RObject&gt; journals)&#xD;&#xA;{&#xD;&#xA;&#x9;var journalObject =journals.First();&#xD;&#xA;&#x9;var journalDataObject = DataObjects.Create(journalObject.GetSource().Source, ContextWrapper.Instance.GetRepository().AsBackend());&#xD;&#xA;&#xD;&#xA;&#x9;var result = BimReportJournalsService.Instance.GetInformationModelCheckResults(journalDataObject);&#xD;&#xA;&#xD;&#xA;      var coordModel = Context.GetObject(result.ModelId);&#xD;&#xA;&#xD;&#xA;&#x9;FillReportHeaderAndFooter(coordModel, journalObject);&#xD;&#xA;&#x9;FillChart(result.TotalSuccessed, result.TotalFailed);&#xD;&#xA;&#xD;&#xA;&#x9;TotalS.Text = result.TotalSuccessed.ToString();&#xD;&#xA;&#x9;TotalF.Text = result.TotalFailed.ToString();&#xD;&#xA;&#x9;Updated.Text = result.Updated.ToLocalTime().ToString();&#xD;&#xA;&#xD;&#xA;&#x9;SchemaF.Text = result.AnalyticSchemaResults.Count().ToString();&#xD;&#xA;&#xD;&#xA;&#x9;var schemasItems = result.AnalyticSchemaResults&#xD;&#xA;&#x9;&#x9;.Select(schemaResult =&gt;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;{&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;var checks = PopulateIssues(schemaResult.CheckResults);&#xD;&#xA;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;var journalItem = new JournalItem()&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;{&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;Name = schemaResult.AnalyticSchemaName,&#xD;&#xA;                      &#x9;&#x9;   &#x9;&#x9;Description = schemaResult.Instruction,&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;Checks =  checks,&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;TotalSuccesses = string.Format(&quot;Всего обьектов прошли проверку: {0}&quot;, schemaResult.SuccessfulRequirementsCount),&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;TotalFailed = string.Format(&quot;Всего несоответствий: {0}&quot;, schemaResult.ApplicabilitySelectionCount - schemaResult.SuccessfulRequirementsCount)&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;};&#xD;&#xA;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;return journalItem;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;})&#xD;&#xA;&#x9;&#x9;.ToList();&#xD;&#xA;&#xD;&#xA;&#x9;return schemasItems.Where(x=&gt; x.Checks.Any()).ToList();&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;private List&lt;Check&gt; PopulateIssues(Dictionary&lt;string, List&lt;BimModelCheckResult&gt;&gt; checkResults)&#xD;&#xA;{&#xD;&#xA;&#x9;var result = new List&lt;Check&gt;();&#xD;&#xA;&#x9;var failedSchemas = 0;&#xD;&#xA;&#x9;var schemaIdx = 0;&#xD;&#xA;&#x9;foreach (var issue in checkResults)&#xD;&#xA;&#x9;{&#xD;&#xA;&#x9;&#x9;var failed = issue.Value.Where( x =&gt; x.Status != 1).ToList();&#xD;&#xA;            if(failed.Any())&#xD;&#xA;&#x9;&#x9;{&#xD;&#xA;&#x9;&#x9;&#x9;failedSchemas++;&#xD;&#xA;&#x9;&#x9;&#x9;var check = new Check()&#xD;&#xA;&#x9;&#x9;&#x9;{&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;Index = failedSchemas.ToString(),&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;Description = issue.Key,&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;Successes = string.Format(&quot;Всего обьектов прошли проверку: {0}&quot;, issue.Value.Count - failed.Count),&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;Failed = string.Format(&quot;Всего несоответствий: {0}&quot;, failed.Count),&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;Issues = new List&lt;IssueItem&gt;()&#xD;&#xA;&#x9;&#x9;&#x9;};&#xD;&#xA;&#x9;&#xD;&#xA;&#x9;&#x9;&#x9;var nodeIdx = 0;&#xD;&#xA;&#x9;&#x9;&#x9;foreach (var cres in issue.Value)&#xD;&#xA;&#x9;&#x9;&#x9;{&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;nodeIdx++;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;check.Issues.Add(new IssueItem()&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;{&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;NodeName = string.Format(&quot;{0} [{1}]&quot;, cres.TargetNodeName, cres.TargetNodeType),&#xD;&#xA; &#x9;&#x9;&#x9;&#x9;&#x9;Index = string.Format(&quot;{0}.{1}&quot;, failedSchemas, nodeIdx),&#x9;&#x9;&#x9;&#x9;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;NodeId = cres.TargetNodeId.NodeId,&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;URL = BimReportService.GetObjectUrl(cres.TargetNodeId),&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;Status = cres.Status == 0 ? &quot;Несоответствие&quot; : &quot;Проверка пройдена&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;});&#xD;&#xA;&#x9;&#x9;&#x9;}&#xD;&#xA;&#x9;&#x9;&#x9;result.Add(check);&#xD;&#xA;&#x9;&#x9;}&#xD;&#xA;&#x9;}&#xD;&#xA;&#x9;&#xD;&#xA;&#x9;return result;&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;        private List&lt;RObject&gt; FindAnalyticSchemas(RObject journal)&#xD;&#xA;        {&#xD;&#xA;            if (journal.Children.Count != 1)&#xD;&#xA;                return new List&lt;RObject&gt;();&#xD;&#xA;&#xD;&#xA;            var schemaFolder = Context.GetObject(journal.Children.FirstOrDefault().Id);&#xD;&#xA;            var schemas = new List&lt;RObject&gt;();&#xD;&#xA;&#xD;&#xA;            RecursiveFindSchemas(schemaFolder, schemas);&#xD;&#xA;&#xD;&#xA;            return schemas;&#xD;&#xA;        }&#xD;&#xA;&#xD;&#xA;        private void RecursiveFindSchemas(RObject folder, List&lt;RObject&gt; schemas)&#xD;&#xA;        {&#xD;&#xA;            if (folder.Children.Any())&#xD;&#xA;            {&#xD;&#xA;                foreach (var child in folder.Children)&#xD;&#xA;                {&#xD;&#xA;                    var obj = Context.GetObject(child.Id);&#xD;&#xA;                    if (obj.Type.Name == &quot;bim_analyticSchema&quot;)&#xD;&#xA;                    {&#xD;&#xA;                        schemas.Add(obj);&#xD;&#xA;                    }&#xD;&#xA;                    else&#xD;&#xA;                    {&#xD;&#xA;                        RecursiveFindSchemas(obj, schemas);&#xD;&#xA;                    }&#xD;&#xA;                }&#xD;&#xA;            }&#xD;&#xA;        }&#xD;&#xA;&#xD;&#xA;class JournalItem&#xD;&#xA;{&#xD;&#xA;&#x9;public string Name { get; set; }&#xD;&#xA;      public string URL { get; set; }&#xD;&#xA;&#x9;public string Description { get; set; }&#xD;&#xA;&#x9;public string TotalSuccesses { get; set; }&#xD;&#xA;&#x9;public string TotalFailed { get; set; }&#xD;&#xA;&#xD;&#xA;&#x9;public List&lt;Check&gt; Checks {get; set; }&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;class Check&#xD;&#xA;{&#xD;&#xA;&#x9;public string Index { get; set; }&#xD;&#xA;&#x9;public string Description { get; set; }&#xD;&#xA;&#x9;public string Successes { get; set; }&#xD;&#xA;&#x9;public string Failed { get; set; }&#xD;&#xA;&#x9;public List&lt;IssueItem&gt; Issues {get; set; }&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;class IssueItem&#xD;&#xA;{&#xD;&#xA;&#x9;public string Index { get; set; }&#xD;&#xA;&#x9;public Guid NodeId { get; set; }&#xD;&#xA;&#x9;public string NodeName{ get; set; }&#xD;&#xA;&#x9;public string Status { get; set; }&#xD;&#xA;&#x9;public string URL{ get; set; }&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;private object TryGetValue(RObject source, string attrName)&#xD;&#xA;{&#xD;&#xA;&#x9;object value;&#xD;&#xA;&#x9;return source.Attributes.TryGetValue(attrName, out value)&#xD;&#xA;&#x9;&#x9;&#x9;? value&#xD;&#xA;&#x9;&#x9;&#x9;: null;&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;" Margins="75, 75, 0, 34" PaperKind="A4" PageWidth="827" PageHeight="1169" Version="20.1" DataSource="#Ref-0" Font="Segoe UI, 9.75pt, charSet=204">
