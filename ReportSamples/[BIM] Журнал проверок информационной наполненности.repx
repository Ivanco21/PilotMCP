            <Item3 Ref="62" ControlType="XRLabel" Name="label2" TextTrimming="EllipsisCharacter" Text="[Description]" SizeF="624.5833,23" LocationFloat="52.41661,7.17366552" Font="Segoe UI, 9.75pt, style=Bold, charSet=204" Padding="2,2,0,0,100">
