<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>PilotMCP</RootNamespace>
    <AssemblyName>PilotMCP</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>0.0.0.1</Version>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="ReportSamples\*.repx" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="PilotMCP.Tests\**" />
    <Content Remove="PilotMCP.Tests\**" />
    <None Remove="PilotMCP.Tests\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Ascon.Pilot.Server.Api" Version="26.1.0" />
    <PackageReference Include="ModelContextProtocol" Version="0.2.0-preview.1" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
    <PackageReference Include="MuPDFCore" Version="2.0.1" />
    <PackageReference Include="PDFtoImage" Version="5.2.0" />
    <PackageReference Include="SkiaSharp" Version="3.119.2" />
    <PackageReference Include="UglyToad.PdfPig" Version="1.7.0-custom-5" />
  </ItemGroup>

</Project>
